# Stage 7: scripts de linha de comando (scripts/admin.php) — nunca pelo navegador.
# O próprio admin.php também recusa qualquer execução fora da linha de comando.
# Só vale no Apache com AllowOverride; em outro servidor, bloqueie a pasta na configuração dele.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
