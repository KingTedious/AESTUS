# Ambientes virtuais e Python
venv/
.venv/
__pycache__/
*.pyc

# Dependências (Composer)
vendor/

# Segredos e Configurações
.env
*.env

# Logs e Cache
*.log
error_log

# Banco de Dados Local
*.sql
# schema versionavel: fonte reproduzivel do banco (Etapa 2).
# Stage 3: comentario movido para linha propria — no fim da linha o "#" virava
# parte do padrao e o schema.sql continuava ignorado.
!schema.sql
# Stage 3: migracoes aditivas versionadas
!migrations/*.sql

# Stage 3: curriculos enviados pelos usuarios sao dados pessoais — nao versionar
uploads/curriculos/*
!uploads/curriculos/.htaccess