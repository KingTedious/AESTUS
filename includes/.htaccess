# Seguranca (PI-01): codigo incluido pelas paginas (configuracao, regras, sessao) - nunca
# acessado direto pelo navegador. O PHP continua lendo estes arquivos pelo disco (require).
# So vale no Apache com AllowOverride; em outro servidor, bloqueie a pasta na configuracao dele.
# Conferencia: scripts\seguranca\verificar_protecao.bat ou "php scripts/jovemconnect.php protecao".
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
