<file path="admin/ia_moderacao.php">
<?php
/* ============================================================
   admin/ia_moderacao.php — análise complementar por IA (Stage 7)

   POST (CSRF) pedido por um administrador na ficha da vaga.
   - Monta só os textos PÚBLICOS do recurso, mascara e-mails, números
     longos (telefone, CPF, cartão) e reduz links ao domínio.
   - Envia ao serviço Flask local (/moderacao), que consulta o Gemini
     se houver chave configurada no servidor.
   - Devolve uma ORIENTAÇÃO (risco, categorias, resumo) + o resultado
     das regras automáticas no texto atual. NADA é alterado: nem a vaga,
     nem a fila, nem a conta. A IA nunca executa ações.
   - Limite: 10 consultas a cada 5 minutos por sessão.
   - Sem JavaScript, responde com uma página simples; com fetch, JSON.
   ============================================================ */
require_once dirname(__DIR__) . '/includes/admin/nucleo.php';
require_once dirname(__DIR__) . '/includes/ia_endereco.php';   // porta da IA (5000 ou a escolhida ao iniciar)

$json = ($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') === 'fetch';
if (!jc_admin_post()) {
    jc_admin_redirecionar('vagas.php');
}
$admin = jc_admin_exigir('ia.consultar', ['json' => $json]);

$tipo = in_array($_POST['tipo'] ?? '', ['vaga', 'jovem', 'empresa'], true) ? $_POST['tipo'] : '';
$id   = ctype_digit((string) ($_POST['id'] ?? '')) ? intval($_POST['id']) : 0;

/** Responde em JSON (fetch) ou numa página simples (sem JavaScript). */
function ia_responder(bool $json, array $r, string $tipo, int $id): void {
    if ($json) {
        header('Content-Type: application/json; charset=utf-8');
        echo json_encode($r, JSON_UNESCAPED_UNICODE);
        exit;
    }
    jc_admin_layout_abrir_simples('Análise complementar por IA');
    echo '<h1 class="adm-titulo">Análise complementar por IA</h1>';
    if (!$r['ok']) {
        echo '<div class="adm-alerta adm-alerta-aviso" role="status">' . jc_admin_icone('info') . '<div>' . jc_e($r['erro'] ?? 'Indisponível.') . '</div></div>';
    } else {
        echo '<div class="adm-alerta adm-alerta-info" role="status">' . jc_admin_icone('sparkles') . '<div><p><strong>Orientação da IA (não altera nada):</strong> risco '
           . jc_e($r['risco_rotulo']) . '.</p><p>' . jc_e($r['resumo']) . '</p>';
        if ($r['categorias']) {
            echo '<ul>';
            foreach ($r['categorias'] as $c) {
                echo '<li>' . jc_e($c) . '</li>';
            }
            echo '</ul>';
        }
        if (!empty($r['do_cache'])) {
            echo '<p class="adm-ajuda">Resposta reaproveitada de uma consulta recente sobre o mesmo texto (até 1 hora).</p>';
        }
        echo '</div></div>';
    }
    echo '<p class="adm-ajuda">Regras automáticas no texto atual: ' . jc_e($r['regras_resumo'] ?: 'nenhuma') . '</p>';
    $volta = $tipo === 'vaga' ? 'vaga.php?id=' . $id : 'conta.php?tipo=' . $tipo . '&id=' . $id;
    echo '<p><a class="adm-btn adm-btn-sec" href="' . jc_e($volta) . '">Voltar</a></p>';
    jc_admin_layout_fechar_simples();
    exit;
}

/** Remove dados pessoais óbvios e reduz links ao domínio. */
function ia_mascarar(string $t): string {
    $t = preg_replace('/[^\s@"\'<>]+@[^\s@"\'<>]+\.[^\s@"\'<>]+/u', '[e-mail]', $t) ?? '';
    $t = preg_replace('~\bhttps?://([^/\s?#]+)\S*~iu', '$1/…', $t) ?? '';            // link → só o domínio
    $t = preg_replace('~\b((?:[a-z0-9-]+\.)+[a-z]{2,})/\S+~iu', '$1/…', $t) ?? '';    // bit.ly/abc → bit.ly/…
    $t = preg_replace('/\d[\d.\-\/ ()]{7,}\d/u', '[número]', $t) ?? '';
    return mb_substr($t, 0, 4000, 'UTF-8');
}

if ($tipo === '' || $id <= 0) {
    ia_responder($json, ['ok' => false, 'erro' => 'Recurso inválido.', 'regras_resumo' => ''], $tipo, $id);
}

// limite por sessão
$agora = time();
$_SESSION['adm_ia'] = array_values(array_filter((array) ($_SESSION['adm_ia'] ?? []), fn($t) => is_int($t) && $t > $agora - 300));
if (count($_SESSION['adm_ia']) >= 10) {
    jc_admin_auditar($conn, intval($admin['id']), 'ia.consulta', $tipo, $id, 'negado', 'limite_sessao');
    ia_responder($json, ['ok' => false, 'erro' => 'Muitas consultas em pouco tempo. Aguarde alguns minutos.', 'regras_resumo' => ''], $tipo, $id);
}
$_SESSION['adm_ia'][] = $agora;

// textos públicos do recurso (chave do mapa → texto)
$textos = [];
if ($tipo === 'vaga') {
    $v = jc_admin_vaga_carregar($conn, $id);
    if ($v) {
        $textos = ['vaga.titulo' => (string) $v['titulo'], 'vaga.descricao' => (string) $v['descricao'],
                   'vaga.salario' => (string) $v['salario']];
        foreach ($v['requisitos'] as $i => $x) {
            $textos['vaga.requisito#' . $i] = (string) $x;
        }
        foreach ($v['beneficios'] as $i => $x) {
            $textos['vaga.beneficio#' . $i] = (string) $x;
        }
    }
    $tipo_ia = 'vaga';
} else {
    $c = jc_admin_conta_carregar($conn, $tipo, $id);
    if ($c && $tipo === 'jovem') {
        $textos = ['jovem.area_interesse' => (string) $c['area_interesse'], 'jovem.resumo' => (string) $c['resumo_profissional']];
        foreach ($c['habilidades'] as $i => $x) {
            $textos['jovem.habilidade#' . $i] = (string) $x;
        }
        foreach ($c['experiencias'] as $i => $x) {
            $textos['jovem.exp_titulo#' . $i] = (string) $x['titulo'];
            $textos['jovem.exp_descricao#' . $i] = (string) $x['descricao'];
        }
    } elseif ($c) {
        $textos = ['empresa.area_atuacao' => (string) $c['area_atuacao'], 'empresa.descricao' => (string) $c['descricao']];
    }
    $tipo_ia = $tipo === 'jovem' ? 'perfil_jovem' : 'perfil_empresa';
}
$textos = array_filter($textos, fn($t) => trim($t) !== '');
if (!$textos) {
    ia_responder($json, ['ok' => false, 'erro' => 'Não há texto público para analisar.', 'regras_resumo' => ''], $tipo, $id);
}

// regras determinísticas no texto atual (servem de base mesmo sem IA)
$regras = [];
foreach ($textos as $chave => $t) {
    $pol = jc_campo(explode('#', $chave)[0])['mod'] ?? null;
    if ($pol) {
        foreach (jc_moderar($t, $pol)['regras'] as $rg) {
            $regras[$rg['cod']] = true;
        }
    }
}
$regras_resumo = implode(', ', array_keys($regras));

// pedido ao Flask (dados mínimos e mascarados)
$campos = [];
$total = 0;
foreach ($textos as $chave => $t) {
    $m = ia_mascarar($t);
    $total += mb_strlen($m);
    if ($total > 9000) {
        break;
    }
    $campos[] = ['nome' => preg_replace('/^[a-z]+\.|#\d+$/', '', $chave), 'texto' => $m];
}
$corpo = json_encode(['tipo' => $tipo_ia, 'campos' => $campos], JSON_UNESCAPED_UNICODE);
$resp = null;
$do_cache = false;
$motivo = 'indisponivel';
$ch = curl_init(jc_ia_url('/moderacao'));
curl_setopt_array($ch, [
    CURLOPT_POST => true,
    CURLOPT_POSTFIELDS => $corpo,
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_CONNECTTIMEOUT => 2,
    CURLOPT_TIMEOUT => 20,
    CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'X-Request-Id: ' . jc_req_id()],
]);
$bruto = curl_exec($ch);
$http = intval(curl_getinfo($ch, CURLINFO_HTTP_CODE));
curl_close($ch);
if (is_string($bruto) && $http === 200) {
    $d = json_decode($bruto, true);
    if (is_array($d) && !empty($d['disponivel']) && is_array($d['analise'] ?? null)) {
        $resp = $d['analise'];
        $do_cache = !empty($d['do_cache']);   // o Flask reaproveita a análise do mesmo texto por até 1 hora
    } elseif (is_array($d)) {
        $motivo = preg_replace('/[^a-z_]/', '', (string) ($d['motivo'] ?? 'indisponivel')) ?: 'indisponivel';
    }
} elseif ($bruto === false) {
    $motivo = 'servico_fora';
}

$rotulos = ['nenhum' => 'nenhum', 'baixo' => 'baixo', 'medio' => 'médio', 'alto' => 'alto'];
if ($resp === null || !isset($rotulos[$resp['risco'] ?? ''])) {
    jc_admin_auditar($conn, intval($admin['id']), 'ia.consulta', $tipo, $id, 'falha', $motivo);
    $msgs = [
        'sem_chave'    => 'A análise por IA não está configurada neste servidor (sem chave do Gemini).',
        'servico_fora' => 'O serviço de IA (Flask) não está rodando.',
        'limite'       => 'O limite de uso da IA foi atingido. Tente mais tarde.',
        'timeout'      => 'A IA demorou demais para responder.',
    ];
    ia_responder($json, ['ok' => false, 'erro' => ($msgs[$motivo] ?? 'A IA não respondeu de forma válida.') . ' As regras automáticas continuam valendo.',
                         'regras_resumo' => $regras_resumo], $tipo, $id);
}

jc_admin_auditar($conn, intval($admin['id']), 'ia.consulta', $tipo, $id, 'sucesso', 'risco_' . $resp['risco']);
ia_responder($json, [
    'ok'            => true,
    'risco'         => $resp['risco'],
    'risco_rotulo'  => $rotulos[$resp['risco']],
    'categorias'    => array_values(array_map('strval', (array) ($resp['categorias'] ?? []))),
    'resumo'        => (string) ($resp['resumo'] ?? ''),
    'confianca'     => (string) ($resp['confianca'] ?? ''),
    'do_cache'      => $do_cache,
    'regras_resumo' => $regras_resumo,
], $tipo, $id);
</file>

<file path="admin/vaga.php">
<?php
/* ============================================================
   admin/vaga.php — ficha e moderação de uma vaga (Stage 7)

   Estado de moderação SEPARADO dos demais dados da vaga:
     aprovada | sinalizada → visível para os jovens
     pendente | rejeitada | suspensa → fora do ar (a empresa continua
     vendo a vaga em "Minhas vagas", com o aviso do motivo)
   Toda decisão exige motivo, justificativa e confirmação; nada volta
   ao ar sozinho. A correção de texto NÃO mexe no local de trabalho
   escolhido pela empresa (as colunas de endereço/local nem entram
   no formulário).
   ============================================================ */
require_once dirname(__DIR__) . '/includes/admin/nucleo.php';

$id = jc_admin_post() ? (ctype_digit((string) ($_POST['id'] ?? '')) ? intval($_POST['id']) : 0) : jc_admin_get_int('id');
$acao = jc_admin_post() ? (string) ($_POST['acao'] ?? '') : '';
// (sem "match", que só existe no PHP 8.0+: o projeto também roda no PHP 7.4)
$permissoes_acao = ['moderar' => 'vagas.moderar', 'editar' => 'vagas.editar'];
$admin = jc_admin_exigir($permissoes_acao[$acao] ?? 'vagas.ver');
if ($id <= 0) {
    jc_admin_pagina_erro(404, 'Vaga não encontrada', 'Informe uma vaga válida.');
}

$erros_edicao = [];
$valores_edicao = null;
$erro_moderacao = null;

if (jc_admin_post()) {
    if (!jc_admin_confirmou()) {
        jc_admin_flash('erro', 'Marque a caixa de confirmação para concluir.');
        jc_admin_redirecionar('vaga.php', ['id' => $id]);
    }
    if ($acao === 'moderar') {
        $r = jc_admin_vaga_moderar($conn, $admin, $id, (string) ($_POST['decisao'] ?? ''), (string) ($_POST['motivo'] ?? ''),
                                   (string) ($_POST['justificativa'] ?? ''), ($_POST['resolver_itens'] ?? '') === '1');
        if ($r['ok']) {
            $estados = jc_admin_estados_vaga();
            jc_admin_flash('sucesso', 'Moderação registrada: ' . ($estados[$r['de']] ?? $r['de']) . ' → ' . ($estados[$r['para']] ?? $r['para'])
                . ($r['itens'] ? '. ' . $r['itens'] . ' sinalização(ões) da fila resolvida(s).' : '.'));
            jc_admin_redirecionar('vaga.php', ['id' => $id]);
        }
        $erro_moderacao = $r['erro'];
    } elseif ($acao === 'editar') {
        if ($e = jc_admin_exigir_reauth($conn, $admin)) {
            jc_admin_flash('erro', $e);
            jc_admin_redirecionar('vaga.php', ['id' => $id]);
        }
        $entrada = is_array($_POST['campos'] ?? null) ? $_POST['campos'] : [];
        $r = jc_admin_editar($conn, $admin, 'vaga', $id, $entrada, (string) ($_POST['justificativa'] ?? ''));
        if ($r['ok']) {
            jc_admin_flash($r['campos'] ? 'sucesso' : 'info', $r['campos']
                ? 'Vaga corrigida (' . count($r['campos']) . ' campo(s)). O local de trabalho não foi alterado.'
                : 'Nada foi alterado: os valores enviados são iguais aos atuais.');
            jc_admin_redirecionar('vaga.php', ['id' => $id]);
        }
        $erros_edicao = $r['erros'];
        $valores_edicao = $entrada;
    } else {
        jc_admin_flash('erro', 'Ação desconhecida.');
        jc_admin_redirecionar('vaga.php', ['id' => $id]);
    }
}

$v = jc_admin_vaga_carregar($conn, $id);
if (!$v) {
    jc_admin_pagina_erro(404, 'Vaga não encontrada', 'Essa vaga não existe (ou foi excluída pela empresa).');
}
$acoes_nomes = jc_admin_acoes();
$estados = jc_admin_estados_vaga();
jc_admin_inicio('Vaga: ' . $v['titulo'], 'vagas.php', $admin, ['Vagas' => 'vagas.php', '#' . $id => null]);

if ($erro_moderacao) {
    echo '<div class="adm-alerta adm-alerta-erro" role="alert">' . jc_admin_icone('x-circle') . '<div>' . jc_e($erro_moderacao) . '</div></div>';
}
if ($erros_edicao) {
    echo '<div class="adm-alerta adm-alerta-erro" role="alert">' . jc_admin_icone('x-circle') . '<div><strong>Corrija os campos:</strong><ul>';
    foreach ($erros_edicao as $m) {
        echo '<li>' . jc_e($m) . '</li>';
    }
    echo '</ul></div></div>';
}
$visivel = in_array($v['moderacao_status'], ['aprovada', 'sinalizada'], true) && $v['empresa_status'] !== 'suspensa';

echo '<div class="adm-grade-2"><section class="adm-cartao" aria-labelledby="t-situacao"><h2 id="t-situacao">Situação</h2><dl class="adm-dl">'
   . '<dt>Moderação</dt><dd>' . jc_admin_selo_vaga($v['moderacao_status'])
   . ($v['moderacao_em'] ? ' <span class="adm-fraco">desde ' . jc_e(jc_admin_data($v['moderacao_em'])) . '</span>' : '') . '</dd>'
   . '<dt>Motivo mostrado à empresa</dt><dd>' . jc_e($v['moderacao_motivo'] ? (jc_moderacao_motivos_vaga()[$v['moderacao_motivo']] ?? $v['moderacao_motivo']) : '—') . '</dd>'
   . '<dt>Visível para os jovens</dt><dd>' . ($visivel ? jc_admin_selo('ok', 'Sim') : jc_admin_selo('erro', 'Não')) . '</dd>'
   . '<dt>Empresa</dt><dd><a href="conta.php?tipo=empresa&amp;id=' . intval($v['empresa_id']) . '">' . jc_e($v['nome_empresa']) . '</a> '
   . jc_admin_selo_conta($v['empresa_status']) . '</dd>'
   . '<dt>Criada</dt><dd>' . jc_e(jc_admin_data($v['criado_em'])) . '</dd>'
   . '<dt>Candidaturas</dt><dd>' . jc_admin_num($v['numeros']['candidaturas']) . '</dd>'
   . '<dt>Favoritada por</dt><dd>' . jc_admin_num($v['numeros']['favoritos']) . ' jovem(ns)</dd>'
   . '<dt>Denúncias</dt><dd>' . jc_admin_num($v['numeros']['denuncias']) . '</dd>'
   . '</dl>';
if ($v['empresa_status'] === 'suspensa') {
    echo '<p class="adm-ajuda adm-mt">A empresa está suspensa: a vaga fica fora do ar enquanto durar a suspensão, qualquer que seja o estado de moderação.</p>';
}
echo '</section>';

$local = '—';
if ($v['local_trabalho'] === 'local' && $v['local_id']) {
    $local = 'Local cadastrado: ' . ($v['local_nome'] ?: ucfirst((string) $v['local_tipo'])) . ' (' . trim(($v['local_cidade'] ?? '') . ' / ' . ($v['local_estado'] ?? ''), ' /') . ')';
} elseif ($v['local_trabalho'] === 'empresa') {
    $local = 'Endereço principal da empresa';
} elseif ($v['local_trabalho'] === null) {
    $local = 'Não informado (vaga anterior aos locais de trabalho)';
}
echo '<section class="adm-cartao" aria-labelledby="t-dados"><h2 id="t-dados">Dados da vaga</h2><dl class="adm-dl">'
   . '<dt>Cidade</dt><dd>' . jc_e(trim(($v['cidade'] ?? '') . ' / ' . ($v['estado'] ?? ''), ' /') ?: '—') . '</dd>'
   . '<dt>Local de trabalho</dt><dd>' . jc_e($local) . '</dd>'
   . '<dt>Contrato</dt><dd>' . jc_e($v['tipo_contrato'] ?: '—') . '</dd>'
   . '<dt>Área</dt><dd>' . jc_e($v['area'] ?: '—') . '</dd>'
   . '<dt>Salário</dt><dd>' . jc_e($v['salario'] ?: '—') . '</dd>'
   . '<dt>Carga horária</dt><dd>' . jc_e($v['carga_horaria'] ?: '—') . '</dd>'
   . '</dl></section></div>';

echo '<section class="adm-cartao" aria-labelledby="t-texto"><h2 id="t-texto">Texto publicado</h2>'
   . '<h3>Título</h3><p>' . jc_e($v['titulo']) . '</p>'
   . '<h3>Descrição</h3><div class="adm-texto-usuario">' . jc_e($v['descricao'] ?? '') . '</div>';
foreach (['Requisitos' => $v['requisitos'], 'Benefícios' => $v['beneficios']] as $rot => $lista) {
    echo '<h3>' . $rot . '</h3>';
    if ($lista) {
        echo '<ul class="adm-lista-chips">';
        foreach ($lista as $x) {
            echo '<li>' . jc_e($x) . '</li>';
        }
        echo '</ul>';
    } else {
        echo '<p>—</p>';
    }
}
if (jc_admin_pode($admin, 'ia.consultar')) {
    echo '<form method="post" action="ia_moderacao.php" data-ia="ia-saida" class="adm-mt">' . jc_admin_csrf_campo()
       . '<input type="hidden" name="tipo" value="vaga"><input type="hidden" name="id" value="' . intval($id) . '">'
       . '<button type="submit" class="adm-btn adm-btn-sec">' . jc_admin_icone('sparkles') . ' Pedir análise complementar por IA</button>'
       . '<p class="adm-ajuda">A IA só dá uma orientação: não aprova, não rejeita e não altera nada. Dados pessoais são mascarados antes do envio.</p></form>'
       . '<div id="ia-saida" class="adm-ia-resultado" tabindex="-1" aria-live="polite" hidden></div>';
}
echo '</section>';

// Sinalizações e denúncias
echo '<section class="adm-cartao" aria-labelledby="t-itens"><h2 id="t-itens">Sinalizações e denúncias</h2>';
if (!$v['itens']) {
    echo jc_admin_vazio('Nenhuma sinalização para esta vaga.');
} else {
    echo '<div class="adm-tabela-rolagem"><table class="adm-tabela"><caption class="adm-sr">Itens da fila desta vaga</caption><thead><tr>'
       . '<th scope="col">Item</th><th scope="col">Campo</th><th scope="col">Origem</th><th scope="col">Regras</th><th scope="col">Risco</th><th scope="col">Situação</th></tr></thead><tbody>';
    foreach ($v['itens'] as $it) {
        echo '<tr><td><a href="moderacao.php?item=' . intval($it['id']) . '">#' . intval($it['id']) . '</a></td>'
           . '<td>' . jc_e(jc_admin_rotulo_campo($it['campo'])) . '</td>'
           . '<td>' . ($it['origem'] === 'denuncia' ? 'Denúncia' : 'Regra automática') . ($it['ocorrencias'] > 1 ? ' (' . intval($it['ocorrencias']) . '×)' : '') . '</td>'
           . '<td>' . jc_admin_regras_html($it['regras']) . '</td><td>' . jc_admin_selo_risco($it['risco']) . '</td>'
           . '<td>' . ($it['estado'] === 'pendente' ? jc_admin_selo('aviso', 'Pendente') : jc_admin_selo('neutro', 'Resolvido')) . '</td></tr>';
    }
    echo '</tbody></table></div>';
}
if ($v['denuncias']) {
    $motivos_den = jc_denuncia_motivos();
    echo '<h3 class="adm-mt">Denúncias recebidas</h3><ul>';
    foreach ($v['denuncias'] as $d) {
        echo '<li><strong>' . jc_e($motivos_den[$d['motivo']] ?? $d['motivo']) . '</strong> · ' . jc_e(jc_admin_data($d['criado_em']))
           . ' · <a href="conta.php?tipo=jovem&amp;id=' . intval($d['jovem_id']) . '">jovem #' . intval($d['jovem_id']) . '</a>'
           . ($d['detalhe'] ? '<div class="adm-texto-usuario">' . jc_e($d['detalhe']) . '</div>' : '') . '</li>';
    }
    echo '</ul>';
}
echo '</section>';

// Ações
echo '<section class="adm-cartao" aria-labelledby="t-acoes"><h2 id="t-acoes">Ações</h2>';
if (jc_admin_pode($admin, 'vagas.moderar')) {
    $possiveis = array_filter(jc_admin_vaga_acoes(), fn($a) => in_array($v['moderacao_status'], $a['de'], true));
    echo '<details class="adm-detalhes"' . ($erro_moderacao ? ' open' : '') . '><summary>' . jc_admin_icone('flag') . ' Decidir a moderação</summary><div>'
       . '<form method="post" action="vaga.php">' . jc_admin_csrf_campo()
       . '<input type="hidden" name="acao" value="moderar"><input type="hidden" name="id" value="' . intval($id) . '">'
       . '<div class="adm-campo"><label for="md-decisao">Decisão</label>'
       . jc_admin_select_html('decisao', 'md-decisao', array_map(fn($a) => $a['rotulo'], $possiveis), '', 'Escolha...', true) . '</div>'
       . '<div class="adm-campo"><label for="md-motivo">Motivo</label><select name="motivo" id="md-motivo" required>'
       . '<option value="">Escolha...</option><optgroup label="Para aprovar">';
    foreach (jc_admin_motivos_aprovacao() as $k => $t) {
        echo '<option value="' . jc_e($k) . '">' . jc_e($t) . '</option>';
    }
    echo '</optgroup><optgroup label="Para revisão, rejeição ou suspensão (texto mostrado à empresa)">';
    foreach (jc_moderacao_motivos_vaga() as $k => $t) {
        echo '<option value="' . jc_e($k) . '">' . jc_e($t) . '</option>';
    }
    echo '</optgroup></select><p class="adm-ajuda">O motivo da segunda lista aparece para a empresa em "Minhas vagas".</p></div>'
       . '<div class="adm-campo adm-campo-check"><input type="checkbox" id="md-itens" name="resolver_itens" value="1" checked>'
       . '<label for="md-itens">Resolver também as sinalizações pendentes desta vaga com esta decisão</label></div>'
       . jc_admin_campos_decisao('md', $admin, false, 'Confirmo a decisão de moderação.')
       . '<div class="adm-acoes"><button type="submit" class="adm-btn">Registrar decisão</button></div></form></div></details>';
}
if (jc_admin_pode($admin, 'vagas.editar')) {
    echo '<details class="adm-detalhes"' . ($erros_edicao ? ' open' : '') . '><summary>' . jc_admin_icone('pencil') . ' Corrigir o texto da vaga</summary><div>'
       . '<p class="adm-ajuda">Corrige título, descrição, salário e carga horária com as mesmas regras do formulário da empresa. '
       . 'O local de trabalho escolhido pela empresa não é alterado. Para mudar o estado da vaga, use "Decidir a moderação".</p>'
       . '<form method="post" action="vaga.php">' . jc_admin_csrf_campo()
       . '<input type="hidden" name="acao" value="editar"><input type="hidden" name="id" value="' . intval($id) . '">';
    foreach (jc_admin_campos_editaveis('vaga') as $chave => $coluna) {
        $def = jc_campo($chave);
        $cid = 'ed-' . str_replace('.', '-', $chave);
        $valor = $valores_edicao[$chave] ?? ($v[$coluna] ?? '');
        $err = $erros_edicao[$chave] ?? null;
        $attr = ' maxlength="' . intval($def['max']) . '"' . (!empty($def['obrig']) ? ' required' : '')
              . ($err ? ' aria-invalid="true" aria-describedby="' . $cid . '-erro"' : '');
        echo '<div class="adm-campo"><label for="' . $cid . '">' . jc_e($def['rotulo']) . '</label>';
        echo $def['tipo'] === 'texto'
            ? '<textarea id="' . $cid . '" name="campos[' . jc_e($chave) . ']" rows="8"' . $attr . ' data-contador>' . jc_e($valor) . '</textarea>'
            : '<input type="text" id="' . $cid . '" name="campos[' . jc_e($chave) . ']" value="' . jc_e($valor) . '"' . $attr . '>';
        if ($err) {
            echo '<p class="adm-erro-campo" id="' . $cid . '-erro">' . jc_e($err) . '</p>';
        }
        echo '</div>';
    }
    echo jc_admin_campos_decisao('ed', $admin, true, 'Confirmo que revisei as correções.')
       . '<div class="adm-acoes"><button type="submit" class="adm-btn">Salvar correções</button></div></form></div></details>';
}
echo '</section>';

// Histórico
echo '<section class="adm-cartao" aria-labelledby="t-hist"><h2 id="t-hist">Histórico de moderação</h2>';
if (!$v['historico']) {
    echo jc_admin_vazio('Nenhuma ação administrativa registrada para esta vaga.');
} else {
    echo '<div class="adm-tabela-rolagem"><table class="adm-tabela"><caption class="adm-sr">Ações administrativas nesta vaga</caption><thead><tr>'
       . '<th scope="col">Quando</th><th scope="col">Quem</th><th scope="col">Ação</th><th scope="col">Decisão e motivo</th><th scope="col">Justificativa</th></tr></thead><tbody>';
    foreach ($v['historico'] as $h) {
        echo '<tr><td>' . jc_e(jc_admin_data($h['criado_em'])) . '</td><td>' . jc_e($h['admin_nome'] ?? 'Linha de comando') . '</td>'
           . '<td>' . jc_e($acoes_nomes[$h['acao']] ?? $h['acao']) . '</td><td><code>' . jc_e($h['motivo_codigo'] ?? '—') . '</code>'
           . ($h['campos'] ? ' <span class="adm-fraco">campos: ' . jc_e($h['campos']) . '</span>' : '') . '</td>'
           . '<td class="adm-quebra">' . jc_e($h['justificativa'] ?? '—') . '</td></tr>';
    }
    echo '</tbody></table></div>';
}
echo '</section>';

jc_admin_fim();
</file>

<file path="assets/css/admin.css">
/* ============================================================
   assets/css/admin.css — Central administrativa (Stage 7)

   Folha própria (a CSP da Central só aceita arquivos do próprio site;
   a style.css pública importa fontes externas). Mesma paleta do
   JovemConnect: escuro por padrão, claro quando o sistema pede.
   Contraste AA, foco sempre visível, alvos de toque ≥ 44 px no celular,
   layout que funciona de 320 px em diante.
   ============================================================ */
:root {
  --bg: #0f0f12;
  --bg-surface: #17171c;
  --bg-card: #1e1e24;
  --bg-input: #25252c;
  --bg-hover: #2a2a32;
  --texto: #f0f0f5;
  --texto-2: #b4b4c6;
  --texto-3: #9b9bb0;
  --borda: #34343f;
  --acento: #4B8EF1;
  --acento-texto: #8ab8f8;
  --acento-fundo: rgba(75, 142, 241, 0.14);
  --ok: #3ccf8e;      --ok-fundo: rgba(60, 207, 142, 0.14);
  --aviso: #f5b84a;   --aviso-fundo: rgba(245, 184, 74, 0.14);
  --erro: #ff7a7a;    --erro-fundo: rgba(255, 122, 122, 0.14);
  --raio: 12px;
  --raio-p: 8px;
  --sombra: 0 1px 2px rgba(0, 0, 0, 0.3);
  --fonte: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  color-scheme: dark;
}
@media (prefers-color-scheme: light) {
  :root {
    /* off-white levemente amarelado, como o tema claro do site (era branco puro) */
    --bg: #faf6eb;
    --bg-surface: #fffaf0;
    --bg-card: #fffaf0;
    --bg-input: #f5f0e7;
    --bg-hover: #efeae1;
    --texto: #1a1a2e;
    --texto-2: #474764;
    --texto-3: #5d5d78;
    --borda: #dfdacd;
    --acento: #105CCB;
    --acento-texto: #0d4ea9;
    --acento-fundo: rgba(16, 92, 203, 0.09);
    --ok: #0f7a4a;      --ok-fundo: rgba(15, 122, 74, 0.1);
    --aviso: #8a5a00;   --aviso-fundo: rgba(196, 128, 0, 0.12);
    --erro: #b42318;    --erro-fundo: rgba(180, 35, 24, 0.09);
    --sombra: 0 1px 3px rgba(20, 20, 50, 0.08);
    color-scheme: light;
  }
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body.adm {
  margin: 0;
  background: var(--bg);
  color: var(--texto);
  font: 15px/1.55 var(--fonte);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
a { color: var(--acento-texto); text-underline-offset: 2px; }
a:hover { text-decoration-thickness: 2px; }
:focus-visible { outline: 3px solid var(--acento); outline-offset: 2px; border-radius: 4px; }
/* campos de data: o foco pode estar no botão do calendário (dentro do campo) */
input[type="date"]:focus-within { outline: 3px solid var(--acento); outline-offset: 2px; }
code, .adm-mono { font-family: var(--mono); font-size: 0.88em; overflow-wrap: anywhere; }
h1, h2, h3 { line-height: 1.25; margin: 0 0 12px; }
h2 { font-size: 1.15rem; }
h3 { font-size: 1rem; }
p { margin: 0 0 10px; }
.adm-sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

.adm-pular {
  position: absolute; left: 12px; top: -60px; z-index: 50;
  background: var(--acento); color: #fff; padding: 10px 16px; border-radius: var(--raio-p); font-weight: 600;
}
.adm-pular:focus { top: 12px; }

/* ── Topo ─────────────────────────────────────────────────────── */
.adm-topo {
  display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  padding: 10px 20px; background: var(--bg-surface); border-bottom: 1px solid var(--borda);
  position: sticky; top: 0; z-index: 20;
}
.adm-topo-marca { display: flex; align-items: center; gap: 10px; min-width: 0; }
.adm-logo {
  display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 9px;
  background: var(--acento); color: #fff; font-weight: 800; font-size: 14px; letter-spacing: .5px; flex-shrink: 0;
}
.adm-topo-nome { font-weight: 700; line-height: 1.2; }
.adm-topo-nome span { display: block; font-weight: 500; font-size: 12px; color: var(--texto-3); }
.adm-topo-usuario { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.adm-topo-quem { color: var(--texto-2); font-size: 14px; display: inline-flex; align-items: center; gap: 6px; max-width: 40vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.adm-form-inline { display: inline; margin: 0; }

/* ── Corpo / navegação ───────────────────────────────────────── */
.adm-corpo { display: flex; flex: 1; min-width: 0; }
.adm-nav { width: 232px; flex-shrink: 0; border-right: 1px solid var(--borda); background: var(--bg-surface); padding: 14px 10px; }
.adm-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; position: sticky; top: 70px; }
.adm-nav a {
  display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: var(--raio-p);
  color: var(--texto-2); text-decoration: none; font-weight: 500; min-height: 44px;
}
.adm-nav a:hover { background: var(--bg-hover); color: var(--texto); }
.adm-nav a[aria-current="page"] { background: var(--acento-fundo); color: var(--acento-texto); font-weight: 650; }
.adm-contador {
  margin-left: auto; background: var(--erro); color: #fff; border-radius: 999px; font-size: 12px; font-weight: 700;
  padding: 1px 8px; min-width: 24px; text-align: center;
}
@media (prefers-color-scheme: light) { .adm-contador { color: #fff; } }
.adm-main { flex: 1; min-width: 0; padding: 24px 28px 40px; max-width: 1280px; }
.adm-main:focus { outline: none; }
.adm-titulo { font-size: 1.5rem; margin: 0 0 18px; }
.adm-rodape { border-top: 1px solid var(--borda); padding: 14px 20px; color: var(--texto-3); font-size: 13px; background: var(--bg-surface); }
.adm-rodape p { margin: 0; }

.adm-migalhas ol { list-style: none; margin: 0 0 8px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; font-size: 13px; color: var(--texto-3); }
.adm-migalhas li + li::before { content: "/"; margin-right: 6px; color: var(--texto-3); }

@media (max-width: 960px) {
  .adm-corpo { flex-direction: column; }
  .adm-nav { width: auto; border-right: 0; border-bottom: 1px solid var(--borda); padding: 6px 8px; }
  .adm-nav ul { flex-direction: row; overflow-x: auto; position: static; gap: 4px; scrollbar-width: thin; }
  .adm-nav a { white-space: nowrap; padding: 8px 12px; }
  .adm-main { padding: 18px 16px 32px; }
  .adm-topo { padding: 10px 16px; }
}

/* ── Componentes ─────────────────────────────────────────────── */
.adm-cartao {
  background: var(--bg-card); border: 1px solid var(--borda); border-radius: var(--raio);
  padding: 18px 20px; margin-bottom: 18px; box-shadow: var(--sombra); min-width: 0;
}
.adm-cartao > h2:first-child { margin-top: 0; }
.adm-grade { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 18px; }
.adm-grade-2 { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
.adm-num { background: var(--bg-card); border: 1px solid var(--borda); border-radius: var(--raio); padding: 16px 18px; }
.adm-num h2 { font-size: 14px; color: var(--texto-2); font-weight: 600; margin: 0 0 6px; display: flex; gap: 8px; align-items: center; }
.adm-num-grande { font-size: 30px; font-weight: 800; line-height: 1.1; margin: 0 0 8px; }
.adm-num ul { list-style: none; margin: 0; padding: 0; font-size: 13.5px; color: var(--texto-2); }
.adm-num li { display: flex; justify-content: space-between; gap: 8px; padding: 2px 0; }
.adm-num li strong { color: var(--texto); }

.adm-alerta {
  display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: var(--raio-p);
  border: 1px solid var(--borda); margin: 0 0 14px; background: var(--bg-card);
}
.adm-alerta .i { margin-top: 3px; }
.adm-alerta > div { min-width: 0; }
.adm-alerta-sucesso { background: var(--ok-fundo); border-color: var(--ok); }
.adm-alerta-sucesso .i { color: var(--ok); }
.adm-alerta-erro { background: var(--erro-fundo); border-color: var(--erro); }
.adm-alerta-erro .i { color: var(--erro); }
.adm-alerta-aviso { background: var(--aviso-fundo); border-color: var(--aviso); }
.adm-alerta-aviso .i { color: var(--aviso); }
.adm-alerta-info { background: var(--acento-fundo); border-color: var(--acento); }
.adm-alerta-info .i { color: var(--acento-texto); }
.adm-alerta ul { margin: 6px 0 0; padding-left: 18px; }

.adm-selo {
  display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12.5px; font-weight: 650;
  border: 1px solid transparent; white-space: nowrap; line-height: 1.6;
}
.adm-selo-ok { background: var(--ok-fundo); color: var(--ok); border-color: var(--ok); }
.adm-selo-aviso { background: var(--aviso-fundo); color: var(--aviso); border-color: var(--aviso); }
.adm-selo-erro { background: var(--erro-fundo); color: var(--erro); border-color: var(--erro); }
.adm-selo-neutro { background: var(--bg-input); color: var(--texto-2); border-color: var(--borda); }

.adm-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 9px 18px;
  border-radius: var(--raio-p); border: 1px solid var(--acento); background: var(--acento); color: #fff;
  font: inherit; font-weight: 650; cursor: pointer; text-decoration: none; line-height: 1.2;
}
.adm-btn:hover { filter: brightness(1.08); }
.adm-btn:disabled { opacity: .55; cursor: not-allowed; }
.adm-btn-sec { background: transparent; color: var(--texto); border-color: var(--borda); }
.adm-btn-sec:hover { background: var(--bg-hover); filter: none; }
.adm-btn-perigo { background: var(--erro); border-color: var(--erro); color: #fff; }
@media (prefers-color-scheme: dark) { .adm-btn-perigo { color: #2a0606; } }
.adm-btn-p { min-height: 36px; padding: 6px 12px; font-size: 14px; }
@media (max-width: 960px) { .adm-btn-p { min-height: 44px; } }
.adm-acoes { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 12px; }

/* ── Formulários ─────────────────────────────────────────────── */
.adm-campo { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; min-width: 0; }
.adm-campo label, .adm-reauth legend { font-weight: 600; font-size: 14px; }
.adm-campo input[type="text"], .adm-campo input[type="email"], .adm-campo input[type="password"],
.adm-campo input[type="search"], .adm-campo input[type="date"], .adm-campo input[type="number"],
.adm-campo select, .adm-campo textarea {
  width: 100%; min-height: 44px; padding: 10px 12px; border-radius: var(--raio-p); border: 1px solid var(--borda);
  background: var(--bg-input); color: var(--texto); font: inherit;
}
.adm-campo textarea { min-height: 96px; resize: vertical; }
.adm-campo input:focus-visible, .adm-campo select:focus-visible, .adm-campo textarea:focus-visible { border-color: var(--acento); }
.adm-campo [aria-invalid="true"] { border-color: var(--erro); }
.adm-campo-check { flex-direction: row; align-items: flex-start; gap: 10px; }
.adm-campo-check input { width: 20px; height: 20px; margin-top: 2px; flex-shrink: 0; accent-color: var(--acento); }
.adm-campo-check label { font-weight: 500; }
.adm-ajuda { font-size: 13px; color: var(--texto-3); margin: 0; }
.adm-erro-campo { font-size: 13px; color: var(--erro); margin: 0; font-weight: 600; }
.adm-obrig { font-weight: 400; color: var(--texto-3); font-size: 13px; }
.adm-contagem { font-size: 12.5px; color: var(--texto-3); text-align: right; margin: 0; }
.adm-reauth { border: 1px dashed var(--aviso); border-radius: var(--raio-p); padding: 12px 14px 2px; margin: 0 0 14px; }
.adm-reauth legend { padding: 0 6px; }
.adm-filtros { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); align-items: end; }
.adm-filtros .adm-campo { margin-bottom: 0; }
.adm-filtros .adm-acoes { margin-top: 0; }

/* ── Tabelas ─────────────────────────────────────────────────── */
.adm-tabela-rolagem { overflow-x: auto; border: 1px solid var(--borda); border-radius: var(--raio); background: var(--bg-card); }
.adm-tabela { width: 100%; border-collapse: collapse; font-size: 14px; }
.adm-tabela caption { text-align: left; padding: 12px 14px; font-weight: 650; color: var(--texto-2); }
.adm-tabela th, .adm-tabela td { padding: 10px 14px; text-align: left; border-top: 1px solid var(--borda); vertical-align: top; }
.adm-tabela thead th { background: var(--bg-surface); font-size: 12.5px; text-transform: uppercase; letter-spacing: .03em; color: var(--texto-3); white-space: nowrap; }
.adm-tabela tbody tr:hover { background: var(--bg-hover); }
.adm-tabela td.adm-num-col { text-align: right; font-variant-numeric: tabular-nums; }
.adm-tabela .adm-quebra { overflow-wrap: anywhere; min-width: 140px; }

.adm-dl { display: grid; grid-template-columns: minmax(130px, 200px) 1fr; gap: 6px 16px; margin: 0; }
.adm-dl dt { color: var(--texto-3); font-size: 14px; }
.adm-dl dd { margin: 0; overflow-wrap: anywhere; }
@media (max-width: 560px) { .adm-dl { grid-template-columns: 1fr; } .adm-dl dd { margin-bottom: 8px; } }

.adm-texto-usuario {
  white-space: pre-wrap; overflow-wrap: anywhere; background: var(--bg-input); border: 1px solid var(--borda);
  border-radius: var(--raio-p); padding: 10px 12px; margin: 0 0 10px; max-height: 360px; overflow-y: auto;
}
.adm-lista-chips { list-style: none; padding: 0; margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 6px; }
.adm-lista-chips li { background: var(--bg-input); border: 1px solid var(--borda); border-radius: 999px; padding: 3px 10px; font-size: 13.5px; overflow-wrap: anywhere; }
.adm-regras { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; min-width: 210px; }
.adm-regras code { color: var(--acento-texto); }
.adm-regras span { color: var(--texto-2); font-size: 13.5px; }

.adm-vazio { text-align: center; padding: 28px 16px; color: var(--texto-2); }
.adm-vazio .i { font-size: 26px; color: var(--texto-3); margin-bottom: 6px; }
.adm-dica { font-size: 13.5px; color: var(--texto-3); }

.adm-paginacao ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 0; margin: 14px 0 0; }
.adm-paginacao a, .adm-paginacao span { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 6px 12px; border-radius: var(--raio-p); border: 1px solid var(--borda); text-decoration: none; }
.adm-paginacao span[aria-current] { color: var(--texto-2); border-style: dashed; }

details.adm-detalhes { border: 1px solid var(--borda); border-radius: var(--raio-p); margin-bottom: 12px; background: var(--bg-card); }
details.adm-detalhes > summary { cursor: pointer; padding: 12px 14px; font-weight: 650; list-style-position: inside; min-height: 44px; }
details.adm-detalhes[open] > summary { border-bottom: 1px solid var(--borda); }
details.adm-detalhes > div { padding: 14px; }

.adm-ia-resultado { margin-top: 12px; }
.adm-ia-resultado[hidden] { display: none; }
.adm-carregando .i-loader { animation: adm-girar 1s linear infinite; }
@keyframes adm-girar { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .adm-carregando .i-loader { animation: none; } * { scroll-behavior: auto !important; } }

/* ── Login / páginas simples ─────────────────────────────────── */
body.adm-simples { justify-content: center; align-items: center; padding: 24px 16px; }
.adm-cartao-central {
  width: 100%; max-width: 440px; background: var(--bg-card); border: 1px solid var(--borda); border-radius: var(--raio);
  padding: 28px 26px; box-shadow: var(--sombra);
}
.adm-marca-central { margin-bottom: 20px; }
.adm-cartao-central .adm-btn { width: 100%; }

@media (forced-colors: active) {
  .adm-selo, .adm-btn, .adm-alerta, .adm-cartao { border: 1px solid CanvasText; }
  .adm-nav a[aria-current="page"] { outline: 2px solid Highlight; }
}
@media print {
  .adm-nav, .adm-topo, .adm-rodape, .adm-acoes, form { display: none !important; }
  body.adm { background: #fff; color: #000; }
}

/* ── Ícones (Lucide, licença ISC/MIT — mesmos da style.css + flag, history, painel, ban, play) ── */
.i {
  display: inline-block; width: 1em; height: 1em; flex-shrink: 0; vertical-align: -0.14em;
  background-color: currentColor;
  -webkit-mask: var(--i) center / contain no-repeat;
          mask: var(--i) center / contain no-repeat;
  forced-color-adjust: none;
}
@media (forced-colors: active) { .i { background-color: CanvasText; } a .i { background-color: LinkText; } button .i { background-color: ButtonText; } }

