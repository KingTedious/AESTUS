        return jsonify({"disponivel": False, "motivo": "entrada_invalida"}), 400
    mensagem = _assist_texto(dados.get("mensagem"), 600)
    if not mensagem:
        return jsonify({"disponivel": False, "motivo": "entrada_invalida"}), 400
    if not CTX_CHAVE:
