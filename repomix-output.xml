        return jsonify({"disponivel": False, "motivo": "resposta_invalida"})
    texto = _assist_limpar_resposta(texto)
    if not texto:
        return jsonify({"disponivel": False, "motivo": "resposta_vazia"})
    return jsonify({"disponivel": True, "resposta": texto})


