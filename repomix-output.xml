            <label class="form-label" for="<?= $_p ?>Estado">UF *</label>
            <input type="text" name="<?= $_n ?>estado" id="<?= $_p ?>Estado" class="form-control" maxlength="2"
                   placeholder="SP" data-local-campo="estado" value="<?= $_v('estado') ?>" required>
        </div>
