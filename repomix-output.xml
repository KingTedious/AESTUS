<file path="includes/admin/sessao.php">
<?php
/* ============================================================
   includes/admin/sessao.php — sessão, CSRF e cabeçalhos da Central
   administrativa (Stage 7)

   A sessão administrativa é SEPARADA da sessão de jovens e empresas:
   - cookie próprio (JCADMIN), válido só no caminho da pasta admin/;
   - HttpOnly, SameSite=Strict e Secure quando a conexão é HTTPS;
   - modo estrito (IDs não gerados pelo servidor são recusados);
   - ID regenerado no login;
   - expira por inatividade (JC_ADMIN_OCIOSO_SEG, padrão 15 min) e por
     tempo total (JC_ADMIN_MAX_SEG, padrão 8 h), contados no servidor;
   - presa ao navegador que fez o login (hash do User-Agent);
   - derrubada quando a conta administrativa muda de "versão de sessão"
     (troca de senha, desativação, "encerrar outras sessões").

   Os valores guardados na sessão são só identificadores e marcas de
   tempo — nunca senha, hash ou segredo do autenticador.
   ============================================================ */

if (!function_exists('jc_admin_sessao_iniciar')) {

    /** Lê um número de segundos do ambiente, dentro de limites seguros. */
    function jc_admin_config_seg(string $nome, int $padrao, int $min, int $max): int {
        $v = getenv($nome);
        $n = ($v === false || $v === '' || !ctype_digit(trim((string) $v))) ? $padrao : intval($v);
        return max($min, min($max, $n));
    }

    function jc_admin_ocioso_seg(): int {
        return jc_admin_config_seg('JC_ADMIN_OCIOSO_SEG', 900, 120, 3600);
    }

    function jc_admin_max_seg(): int {
        return jc_admin_config_seg('JC_ADMIN_MAX_SEG', 28800, 900, 43200);
    }

    /** Janela da reautenticação para operações críticas (segundos). */
    function jc_admin_reauth_seg(): int {
        return 300;
    }

    function jc_admin_https(): bool {
        return (!empty($_SERVER['HTTPS']) && strtolower((string) $_SERVER['HTTPS']) !== 'off')
            || (($_SERVER['SERVER_PORT'] ?? '') === '443');
    }

    /** Conexão local (localhost)? Usado só para o aviso de "sem HTTPS". */
    function jc_admin_local(): bool {
        $host = strtolower((string) preg_replace('/:\d+$/', '', (string) ($_SERVER['HTTP_HOST'] ?? '')));
        return in_array($host, ['localhost', '127.0.0.1', '[::1]'], true);
    }

    /** Caminho do cookie: a pasta admin/ do projeto (ex.: /JovemConnect/admin/). */
    function jc_admin_cookie_path(): string {
        $dir = str_replace('\\', '/', dirname((string) ($_SERVER['SCRIPT_NAME'] ?? '/admin/index.php')));
        return rtrim($dir, '/') . '/';
    }

    /** Hash do navegador (a sessão só vale no navegador que fez o login). */
    function jc_admin_hash_navegador(): string {
        return hash('sha256', 'jc-admin-ua|' . (string) ($_SERVER['HTTP_USER_AGENT'] ?? ''));
    }

    /** Inicia (ou retoma) a sessão administrativa. Não valida o login. */
    function jc_admin_sessao_iniciar(): void {
        if (session_status() === PHP_SESSION_ACTIVE) {
            if (session_name() === 'JCADMIN') {
                return;
            }
            // nunca misturar com a sessão pública
            session_write_close();
        }
        if (PHP_SAPI !== 'cli') {
            @ini_set('session.use_strict_mode', '1');
            @ini_set('session.use_only_cookies', '1');
            @ini_set('session.use_trans_sid', '0');
            @ini_set('session.cookie_httponly', '1');
            @ini_set('session.gc_maxlifetime', (string) jc_admin_max_seg());
            session_name('JCADMIN');
            session_set_cookie_params([
                'lifetime' => 0,
                'path'     => jc_admin_cookie_path(),
                'httponly' => true,
                'samesite' => 'Strict',
                'secure'   => jc_admin_https(),
            ]);
        }
        session_start();
    }

    /** Apaga a sessão administrativa e o cookie. */
    function jc_admin_sessao_destruir(): void {
        if (session_status() !== PHP_SESSION_ACTIVE) {
            jc_admin_sessao_iniciar();
        }
        $_SESSION = [];
        if (PHP_SAPI !== 'cli' && !headers_sent()) {
            setcookie('JCADMIN', '', [
                'expires'  => time() - 3600,
                'path'     => jc_admin_cookie_path(),
                'httponly' => true,
                'samesite' => 'Strict',
                'secure'   => jc_admin_https(),
            ]);
        }
        @session_destroy();
    }

    /**
     * Grava a identidade administrativa na sessão depois de um login válido.
     * O ID da sessão é trocado (impede fixação de sessão).
     */
    function jc_admin_sessao_entrar(array $admin): void {
        jc_admin_sessao_iniciar();
        session_regenerate_id(true);
        $agora = time();
        $_SESSION = [
            'adm_id'         => intval($admin['id']),
            'adm_versao'     => intval($admin['sessao_versao']),
            'adm_inicio'     => $agora,
            'adm_ultimo'     => $agora,
            'adm_ua'         => jc_admin_hash_navegador(),
            'adm_csrf'       => bin2hex(random_bytes(32)),
            'adm_reauth_ate' => $agora + jc_admin_reauth_seg(),   // acabou de digitar a senha
        ];
    }

    /**
     * Confere os prazos e o navegador da sessão atual.
     * @return string|null  null = válida; senão o código do motivo
     */
    function jc_admin_sessao_problema(): ?string {
        if (empty($_SESSION['adm_id'])) {
            return 'sem_login';
        }
        $agora = time();
        if ($agora - intval($_SESSION['adm_inicio'] ?? 0) > jc_admin_max_seg()) {
            return 'tempo_total';
        }
        if ($agora - intval($_SESSION['adm_ultimo'] ?? 0) > jc_admin_ocioso_seg()) {
            return 'inatividade';
        }
        if (!hash_equals((string) ($_SESSION['adm_ua'] ?? ''), jc_admin_hash_navegador())) {
            return 'navegador';
        }
        return null;
    }

    /** Mensagem amigável para cada motivo de fim de sessão. */
    function jc_admin_msg_fim_sessao(string $motivo): string {
        return [
            'inatividade' => 'Sua sessão terminou por inatividade. Entre de novo.',
            'tempo_total' => 'Sua sessão atingiu o tempo máximo. Entre de novo.',
            'navegador'   => 'Sua sessão foi encerrada por segurança. Entre de novo.',
            'versao'      => 'Sua sessão foi encerrada (senha alterada ou sessões encerradas). Entre de novo.',
            'inativo'     => 'Esta conta administrativa está desativada.',
            'logout'      => 'Você saiu da Central administrativa.',
        ][$motivo] ?? 'Entre para continuar.';
    }

    // ── Cabeçalhos de segurança ─────────────────────────────────────────

    /** Nonce desta resposta (para o <script>/<style> permitidos pela CSP). */
    function jc_admin_nonce(): string {
        static $n = null;
        if ($n === null) {
            $n = rtrim(strtr(base64_encode(random_bytes(18)), '+/', '-_'), '=');
        }
        return $n;
    }

    function jc_admin_cabecalhos(): void {
        if (headers_sent() || PHP_SAPI === 'cli') {
            return;
        }
        $nonce = jc_admin_nonce();
        header("Content-Security-Policy: default-src 'self'; script-src 'self' 'nonce-{$nonce}'; "
             . "style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; "
             . "form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'");
        header('X-Frame-Options: DENY');
        header('X-Content-Type-Options: nosniff');
        header('Referrer-Policy: no-referrer');
        header('Cache-Control: no-store, max-age=0');
        header('Pragma: no-cache');
        header('Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()');
        header('Cross-Origin-Opener-Policy: same-origin');
        header('X-Robots-Tag: noindex, nofollow');
    }

    // ── CSRF ────────────────────────────────────────────────────────────

    function jc_admin_csrf_token(): string {
        if (empty($_SESSION['adm_csrf']) || !is_string($_SESSION['adm_csrf'])) {
            $_SESSION['adm_csrf'] = bin2hex(random_bytes(32));
        }
        return $_SESSION['adm_csrf'];
    }

    function jc_admin_csrf_campo(): string {
        return '<input type="hidden" name="_csrf" value="' . htmlspecialchars(jc_admin_csrf_token(), ENT_QUOTES, 'UTF-8') . '">';
    }

    /**
     * Confere o token (campo _csrf ou cabeçalho X-CSRF-Token) e, quando o
     * navegador informa, a origem da requisição (mesmo host).
     */
    function jc_admin_csrf_valido(): bool {
        $enviado = $_POST['_csrf'] ?? ($_SERVER['HTTP_X_CSRF_TOKEN'] ?? null);
        if (!is_string($enviado) || empty($_SESSION['adm_csrf']) || !hash_equals((string) $_SESSION['adm_csrf'], $enviado)) {
            return false;
        }
        $origem = (string) ($_SERVER['HTTP_ORIGIN'] ?? '');
        if ($origem !== '' && $origem !== 'null') {
            $p = parse_url($origem);
            $host = ($p['host'] ?? '') . (isset($p['port']) ? ':' . $p['port'] : '');
            if (strcasecmp($host, (string) ($_SERVER['HTTP_HOST'] ?? '')) !== 0) {
                return false;
            }
        }
        return true;
    }

    /** Requisição POST? (toda ação que muda estado na Central é POST) */
    function jc_admin_post(): bool {
        return ($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST';
    }

    // ── Mensagens entre redirecionamentos (padrão POST → redirect → GET) ─

    function jc_admin_flash(string $tipo, string $texto): void {
        $_SESSION['adm_flash'][] = ['tipo' => $tipo, 'texto' => $texto];
    }

    function jc_admin_flash_pegar(): array {
        $f = $_SESSION['adm_flash'] ?? [];
        unset($_SESSION['adm_flash']);
        return is_array($f) ? $f : [];
    }

    /** Redireciona dentro da pasta admin/ (só nomes de página conhecidos). */
    function jc_admin_redirecionar(string $pagina, array $params = []): void {
        if (!preg_match('/^[a-z_]+\.php$/', $pagina)) {
            $pagina = 'index.php';
        }
        $url = $pagina . ($params ? '?' . http_build_query($params) : '');
        if (!headers_sent()) {
            header('Location: ' . $url, true, 303);
        }
        exit;
    }
}
</file>

<file path="includes/admin/totp.php">
<?php
/* ============================================================
   includes/admin/totp.php — segundo fator (TOTP, RFC 6238) da
   Central administrativa (Stage 7)

   Código de 6 dígitos que muda a cada 30 s, gerado por qualquer app
   autenticador (Google Authenticator, Microsoft Authenticator, Aegis,
   2FAS...). Implementação própria, sem dependências:
   HMAC-SHA1 sobre o número do intervalo, segredo de 160 bits em base32.

   - Aceita o intervalo atual e um de cada lado (relógios desajustados).
   - Um código só vale UMA vez: o intervalo aceito é gravado em
     administradores.mfa_ultimo_passo e códigos daquele intervalo ou
     anteriores são recusados (impede reaproveitar um código visto).
   - O segredo é gerado e mostrado UMA vez pela linha de comando
     (scripts/admin.php); a Central nunca exibe o segredo.
   ============================================================ */

if (!function_exists('jc_totp_verificar')) {

    function jc_base32_codificar(string $bin): string {
        $alfabeto = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
        $bits = '';
        foreach (str_split($bin) as $c) {
            $bits .= str_pad(decbin(ord($c)), 8, '0', STR_PAD_LEFT);
        }
        $saida = '';
        foreach (str_split($bits, 5) as $grupo) {
            $saida .= $alfabeto[bindec(str_pad($grupo, 5, '0'))];
        }
        return $saida;
    }

    function jc_base32_decodificar(string $b32): ?string {
        $b32 = strtoupper(preg_replace('/[\s=-]/', '', $b32) ?? '');
        if ($b32 === '' || !preg_match('/^[A-Z2-7]+$/', $b32)) {
            return null;
        }
        $alfabeto = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
        $bits = '';
        foreach (str_split($b32) as $c) {
            $bits .= str_pad(decbin(strpos($alfabeto, $c)), 5, '0', STR_PAD_LEFT);
        }
        $bin = '';
        foreach (str_split($bits, 8) as $byte) {
            if (strlen($byte) === 8) {
                $bin .= chr(bindec($byte));
            }
        }
        return $bin;
    }

    /** Segredo novo (160 bits) em base32. */
    function jc_totp_novo_segredo(): string {
        return jc_base32_codificar(random_bytes(20));
    }

    /** Código de 6 dígitos para um intervalo. */
    function jc_totp_codigo(string $segredo_b32, int $passo): string {
        $chave = jc_base32_decodificar($segredo_b32);
        if ($chave === null) {
            return '';
        }
        $msg  = pack('N*', 0) . pack('N*', $passo);
        $hash = hash_hmac('sha1', $msg, $chave, true);
        $off  = ord($hash[19]) & 0x0f;
        $num  = ((ord($hash[$off]) & 0x7f) << 24) | (ord($hash[$off + 1]) << 16)
              | (ord($hash[$off + 2]) << 8) | ord($hash[$off + 3]);
        return str_pad((string) ($num % 1000000), 6, '0', STR_PAD_LEFT);
    }

    function jc_totp_passo_atual(): int {
        return intdiv(time(), 30);
    }

    /**
     * Confere um código. @return int|null o intervalo aceito (para gravar) ou null
     */
    function jc_totp_verificar(string $segredo_b32, string $codigo, ?int $ultimo_passo): ?int {
        $codigo = preg_replace('/\D/', '', $codigo) ?? '';
        if (strlen($codigo) !== 6) {
            return null;
        }
        $atual = jc_totp_passo_atual();
        foreach ([0, -1, 1] as $d) {
            $p = $atual + $d;
            if ($ultimo_passo !== null && $p <= $ultimo_passo) {
                continue;   // código já usado (ou mais antigo que o último usado)
            }
            if (hash_equals(jc_totp_codigo($segredo_b32, $p), $codigo)) {
                return $p;
            }
        }
        return null;
    }

    /**
     * Grava o intervalo aceito de forma atômica (só avança): se outra
     * requisição já usou o mesmo código, esta perde. @return bool
     */
    function jc_totp_gravar_passo(mysqli $conn, int $admin_id, int $passo): bool {
        $stmt = $conn->prepare(
            "UPDATE administradores SET mfa_ultimo_passo = ?
             WHERE id = ? AND (mfa_ultimo_passo IS NULL OR mfa_ultimo_passo < ?)"
        );
        $stmt->bind_param("iii", $passo, $admin_id, $passo);
        $stmt->execute();
        $ok = $stmt->affected_rows === 1;
        $stmt->close();
        return $ok;
    }

    /** Endereço otpauth:// para cadastrar no app autenticador. */
    function jc_totp_uri(string $segredo_b32, string $email): string {
        $emissor = 'JovemConnect Admin';
        return 'otpauth://totp/' . rawurlencode($emissor . ':' . $email)
             . '?secret=' . $segredo_b32 . '&issuer=' . rawurlencode($emissor) . '&algorithm=SHA1&digits=6&period=30';
    }
}
</file>

<file path="includes/card_vaga.php">
<?php
/* ============================================================
   includes/card_vaga.php — card de vaga do jovem (padrão único)

   Modelo: o card do painel do jovem (dashboard/jovem.php), agora com a
   estrela de favoritar que existia só em Vagas/listar.php. Usado no painel
   e na lista completa para os cards não divergirem mais.

   - O card inteiro abre o detalhe da vaga (Vagas/listar.php?id=...); o
     título é um link de verdade, para quem navega pelo teclado.
   - A estrela e o botão de IA NÃO disparam a navegação do card.
   - Favoritar reaproveita Vagas/favoritar.php sem mudanças (sessão do
     jovem, CSRF, vaga visível, UNIQUE no banco). O JavaScript é o mesmo
     que estava em listar.php, só com o endereço como parâmetro.
   - O botão de IA chama a função avaliarMatch() de cada página, que
     continua a mesma.

   Campos esperados em $vaga: id, titulo, nome_empresa, area, salario,
   carga_horaria, cidade, estado, eh_favorito (0/1).
   ============================================================ */

/**
 * Imprime um card de vaga.
 * @param array  $vaga        linha da consulta (ver campos acima)
 * @param string $pasta_vagas caminho até a pasta Vagas/ a partir da página ('../Vagas/' ou '')
 * @param string $voltar      chave de retorno do detalhe ('painel', ...) ou '' (volta para a lista)
 */
function jc_card_vaga(array $vaga, string $pasta_vagas, string $voltar = ''): void
{
    $id          = intval($vaga['id']);
    $eh_favorito = !empty($vaga['eh_favorito']);
    $detalhe     = $pasta_vagas . 'listar.php?id=' . $id . ($voltar !== '' ? '&voltar=' . rawurlencode($voltar) : '');
    $detalhe_h   = htmlspecialchars($detalhe);
    $detalhe_js  = htmlspecialchars(json_encode($detalhe, JSON_UNESCAPED_SLASHES | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP | JSON_HEX_TAG));
    $rotulo_fav  = $eh_favorito ? 'Remover dos favoritos' : 'Salvar nos favoritos';
    ?>
            <div class="job-card"
                 onclick="location.href=<?= $detalhe_js ?>"
                 style="cursor:pointer;"
                 title="Ver detalhes da vaga">

                <!-- Título + badge de área + favorito -->
                <div class="job-card-top">
                    <h3 class="job-card-title">
                        <!-- Link de verdade: pelo teclado também se chega aos detalhes -->
                        <a href="<?= $detalhe_h ?>"
                           onclick="event.stopPropagation()"
                           style="color:inherit;text-decoration:none;">
                            <?= htmlspecialchars($vaga['titulo']) ?>
                        </a>
                    </h3>
                    <div class="d-flex align-center gap-8">
                        <?php if (!empty($vaga['area'])): ?>
                        <span class="badge badge-area"><?= htmlspecialchars($vaga['area']) ?></span>
                        <?php endif; ?>
                        <!-- Favoritar (AJAX POST em Vagas/favoritar.php) — não abre o detalhe -->
                        <button
                            type="button"
                            class="btn-fav"
                            id="fav-<?= $id ?>"
                            onclick="event.stopPropagation(); toggleFavorito(<?= $id ?>, this)"
                            title="<?= $rotulo_fav ?>"
                            aria-label="<?= $rotulo_fav ?>"
                            aria-pressed="<?= $eh_favorito ? 'true' : 'false' ?>"
                            style="
                                background:none;border:none;cursor:pointer;
                                font-size:18px;line-height:1;
                                color:<?= $eh_favorito ? 'var(--jc-favorito, #facc15)' : 'var(--text-muted)' ?>;
                                transition:color var(--dur),transform var(--dur);
                            ">
                            <span class="i <?= $eh_favorito ? 'i-star-cheia' : 'i-star' ?>" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>

                <!-- Empresa -->
                <div class="job-card-company">
                    <span class="i i-building" aria-hidden="true"></span>
                    <?= htmlspecialchars($vaga['nome_empresa']) ?>
                </div>

                <!-- Salário + carga horária -->
                <div class="job-card-meta">
                    <?php if (!empty($vaga['salario'])): ?>
                    <div class="job-card-meta-item">
                        <span class="i i-banknote" aria-hidden="true"></span>
                        <span>R$ <?= htmlspecialchars($vaga['salario']) ?></span>
                    </div>
                    <?php endif; ?>

                    <?php if (!empty($vaga['carga_horaria'])): ?>
                    <div class="job-card-meta-item">
                        <span class="i i-clock" aria-hidden="true"></span>
                        <span><?= htmlspecialchars($vaga['carga_horaria']) ?></span>
                    </div>
                    <?php endif; ?>
                </div>

                <!-- Localização -->
                <?php if (!empty($vaga['cidade'])): ?>
                <div class="job-card-location">
                    <span class="i i-map-pin" aria-hidden="true"></span>
                    <span>
                        <?= htmlspecialchars($vaga['cidade']) ?>
                        <?= !empty($vaga['estado']) ? ', ' . htmlspecialchars($vaga['estado']) : '' ?>
                    </span>
                </div>
                <?php endif; ?>

                <!-- Botão IA (rodapé do card) — não abre o detalhe -->
                <div class="job-card-footer" onclick="event.stopPropagation()">
                    <button
                        type="button"
                        class="btn btn-ia"
                        onclick="avaliarMatch(<?= $id ?>, this)"
                        data-vaga="<?= $id ?>">
                        <span class="i i-sparkles" aria-hidden="true"></span> Avaliar Match com IA
                    </button>
                </div>

            </div><!-- /.job-card -->
    <?php
}

/**
 * Imprime o JavaScript da estrela (o mesmo de Vagas/listar.php, com o endereço como parâmetro).
 * @param string $url_favoritar endereço de Vagas/favoritar.php a partir da página
 */
function jc_card_vaga_script(string $url_favoritar): void
{
    ?>
<script>
/* ── Toggle favorito (AJAX POST) — includes/card_vaga.php ──── */
async function toggleFavorito(vagaId, btn) {
    if (btn.disabled) return;                  // Ignora cliques repetidos durante a requisição
    btn.disabled = true;
    btn.setAttribute('aria-busy', 'true');
    btn.style.transform = 'scale(.8)';
    const fd = new FormData();
    fd.append('vaga_id', vagaId);
    try {
        const res = await fetch(<?= json_encode($url_favoritar, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG) ?>, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: fd,
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || typeof data.favorito !== 'boolean')   // resposta inesperada também é erro
            throw Object.assign(new Error(data.error || ''), { amigavel: !!data.error });
        const rotulo = data.favorito ? 'Remover dos favoritos' : 'Salvar nos favoritos';
        btn.replaceChildren(jcIcone(data.favorito ? 'star-cheia' : 'star'));   // Ícone
        btn.style.color = data.favorito ? 'var(--jc-favorito, #facc15)' : 'var(--text-muted)';
        btn.title       = rotulo;
        btn.setAttribute('aria-label', rotulo);  // O leitor de tela acompanha o estado
        btn.setAttribute('aria-pressed', data.favorito ? 'true' : 'false');
    } catch (err) {
        console.error('Erro ao favoritar:', err);
        window.jcAviso?.(err?.amigavel ? err.message : 'Não foi possível atualizar os favoritos. Tente de novo.');
    } finally {
        btn.style.transform = '';
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
    }
}
</script>
    <?php
}
