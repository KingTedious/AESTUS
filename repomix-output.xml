            <label class="form-label" for="<?= $_p ?>Cidade">Cidade *</label>
            <input type="text" name="<?= $_n ?>cidade" id="<?= $_p ?>Cidade" class="form-control" maxlength="100"
                   data-local-campo="cidade" value="<?= $_v('cidade') ?>" required>
        </div>
