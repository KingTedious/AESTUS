           . '<td><code>' . jc_e($h['motivo_codigo'] ?? '—') . '</code></td>'
           . '<td class="adm-quebra">' . jc_e($h['justificativa'] ?? '—') . '</td><td><code>' . jc_e($h['campos'] ?? '—') . '</code></td></tr>';
    }
