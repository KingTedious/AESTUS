            <?php endforeach; ?>
        </ul>
    </div>
    <?php endif; ?>

    <!-- Formulário em etapas (includes/etapas.php). Sem JavaScript, todas as
         etapas aparecem juntas e o envio funciona igual. data-envio-unico
