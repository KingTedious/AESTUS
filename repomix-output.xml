<?php if (empty($GLOBALS['_jc_locais_campos_js'])): $GLOBALS['_jc_locais_campos_js'] = true; ?>
<script>
/* CEP do local de trabalho → rua, bairro, cidade e UF (ViaCEP).
   Número e complemento são digitados; nada é preenchido sem resposta do ViaCEP. */
(function () {
    const ultimo = new WeakMap();
    async function buscar(campo) {
        const bloco  = campo.closest('[data-locais-campos]');
        const status = bloco?.querySelector('[data-local-cep-status]');
        const raw    = campo.value.replace(/\D/g, '');
        if (raw.length !== 8 || ultimo.get(campo) === raw) return;
        ultimo.set(campo, raw);
        if (status) status.textContent = 'Buscando endereço...';
        try {
            const res = await fetch(`https://viacep.com.br/ws/${raw}/json/`);
            const d   = await res.json();
            if (d.erro) { if (status) status.textContent = 'CEP não encontrado — preencha o endereço manualmente.'; return; }
            const por = { logradouro: d.logradouro, bairro: d.bairro, cidade: d.localidade, estado: d.uf };
            bloco.querySelectorAll('[data-local-campo]').forEach(el => {
                const k = el.getAttribute('data-local-campo');
                if (k in por) el.value = por[k] || '';
            });
            if (status) status.replaceChildren(jcIcone('check-circle'), ' Endereço preenchido. Informe o número e o complemento.');
        } catch {
            if (status) status.textContent = 'Não foi possível buscar o CEP agora — preencha manualmente.';
        }
    }
    document.addEventListener('input', e => {
        const campo = e.target.closest?.('[data-local-cep]');
        if (!campo) return;
        let v = campo.value.replace(/\D/g, '').slice(0, 8);
        if (v.length > 5) v = v.slice(0, 5) + '-' + v.slice(5);
        campo.value = v;
        if (v.length === 9) buscar(campo);
    });
    document.addEventListener('focusout', e => {
        const campo = e.target.closest?.('[data-local-cep]');
        if (campo) buscar(campo);
    });
    // começa sem rebuscar o CEP já salvo (não sobrescreve o que foi digitado à mão)
    document.querySelectorAll('[data-local-cep]').forEach(c => ultimo.set(c, c.value.replace(/\D/g, '')));
})();
</script>
<?php endif; ?>
</file>

<file path="includes/mailer.php">
<?php
/**
 * includes/mailer.php
 *
 * Envio de e-mails via SMTP usando PHPMailer (instalado via Composer —
 * ver composer.json / vendor/). Implementa a função enviarCodigoVerificacao(),
 * já usada por verificacoes/verificar_email.php e por recuperar_senha.php,
 * com a assinatura descoberta nesses dois chamadores:
 *
 *     enviarCodigoVerificacao(string $email, string $nome, string $codigo): bool
 *
 * Credenciais SMTP vêm de variáveis de ambiente (arquivo .env na raiz do
 * projeto — ver .env.example para a lista de chaves esperadas). Nunca
 * ficam hardcoded neste arquivo.
 */

require_once __DIR__ . '/env.php';

$__vendorAutoload = dirname(__DIR__) . '/vendor/autoload.php';
if (is_file($__vendorAutoload)) {
    require_once $__vendorAutoload;
}
unset($__vendorAutoload);

if (!function_exists('jc_mailer_disponivel')) {
    /**
     * O envio de e-mail está instalado (PHPMailer em vendor/) e configurado
     * (SMTP_HOST, SMTP_USER e SMTP_PASS no .env)? Não abre conexão nem revela
     * qual item falta. Usado para não fingir que um código foi enviado
     * (remediação, Lote A — recuperar_senha.php).
     */
    function jc_mailer_disponivel(): bool {
        return class_exists(\PHPMailer\PHPMailer\PHPMailer::class)
            && (getenv('SMTP_HOST') ?: '') !== ''
            && (getenv('SMTP_USER') ?: '') !== ''
            && (getenv('SMTP_PASS') ?: '') !== '';
    }
}

if (!function_exists('enviarCodigoVerificacao')) {

    function enviarCodigoVerificacao(string $email, string $nome, string $codigo): bool {

        if (!class_exists(\PHPMailer\PHPMailer\PHPMailer::class)) {
            error_log('[mailer.php] PHPMailer não encontrado em vendor/. Rode "composer install".');
            return false;
        }

        $host      = getenv('SMTP_HOST') ?: '';
        $port      = (int) (getenv('SMTP_PORT') ?: 587);
        $usuario   = getenv('SMTP_USER') ?: '';
        $senha     = getenv('SMTP_PASS') ?: '';
        $seguranca = getenv('SMTP_SECURE') ?: 'tls';
        $deEmail   = getenv('SMTP_FROM_EMAIL') ?: $usuario;
        $deNome    = getenv('SMTP_FROM_NAME') ?: 'JovemConnect';

        if ($host === '' || $usuario === '' || $senha === '') {
            // Não expõe qual credencial falta em detalhe — só que a configuração está ausente.
            error_log('[mailer.php] Configuração de SMTP ausente ou incompleta (SMTP_HOST/SMTP_USER/SMTP_PASS no .env).');
            return false;
        }

        $mail = new \PHPMailer\PHPMailer\PHPMailer(true);

        try {
            $mail->isSMTP();
            $mail->Host       = $host;
            $mail->SMTPAuth   = true;
            $mail->Username   = $usuario;
            $mail->Password   = $senha;
            if ($seguranca === 'ssl') {
                $mail->SMTPSecure = \PHPMailer\PHPMailer\PHPMailer::ENCRYPTION_SMTPS;
            } elseif ($seguranca === 'none') {
                // Só para relays locais/confiáveis sem TLS (ex.: ambiente de teste).
                // Provedores reais de e-mail exigem "tls" ou "ssl" — ver .env.example.
                $mail->SMTPSecure  = '';
                $mail->SMTPAutoTLS = false;
            } else {
                $mail->SMTPSecure = \PHPMailer\PHPMailer\PHPMailer::ENCRYPTION_STARTTLS;
            }
            $mail->Port       = $port;
            $mail->CharSet    = 'UTF-8';
            $mail->Timeout    = 10;

            $mail->setFrom($deEmail, $deNome);
            $mail->addAddress($email, $nome);

            $mail->isHTML(true);
            $mail->Subject = 'Seu código de verificação — JovemConnect';
            $mail->Body =
                '<div style="font-family:Arial,sans-serif;max-width:480px;margin:0 auto;">' .
                '<p>Olá, ' . htmlspecialchars($nome) . '!</p>' .
                '<p>Use o código abaixo para concluir a verificação da sua conta no JovemConnect:</p>' .
                '<p style="font-size:28px;font-weight:bold;letter-spacing:6px;text-align:center;' .
                'background:#f1f5f9;padding:16px;border-radius:8px;">' . htmlspecialchars($codigo) . '</p>' .
                '<p>Esse código expira em 15 minutos.</p>' .
                '<p style="color:#71717a;font-size:12px;">Se você não solicitou isso, ignore este e-mail.</p>' .
                '</div>';
            $mail->AltBody = "Seu código de verificação JovemConnect: {$codigo} (expira em 15 minutos). "
                . "Se você não solicitou isso, ignore este e-mail.";

            $mail->send();
            return true;

        } catch (\PHPMailer\PHPMailer\Exception $e) {
            // ErrorInfo é a mensagem de protocolo do PHPMailer/SMTP — nunca inclui
            // a senha configurada nem o código de verificação enviado.
            error_log('[mailer.php] Falha ao enviar e-mail: ' . $mail->ErrorInfo);
            return false;
        }
    }
}
</file>

<file path="includes/moderacao.php">
<?php
require_once __DIR__ . '/compat.php';   // PHP 7.4/8.0: str_contains etc. (includes/compat.php)
/* ============================================================
   includes/moderacao.php — moderação de conteúdo (Stage 7)

   Camada 2 de 2 (a camada 1, validação estrutural, fica em
   includes/validacao.php). Avalia se um texto JÁ VÁLIDO apresenta
   RISCO ou viola as regras da plataforma. Identifica indícios — não
   decide sobre a intenção de ninguém.

   Regras determinísticas e centralizadas (jc_mod_regras()). Cada regra
   tem código, categoria, nível de risco, as políticas de campo em que
   vale e um texto para a equipe de moderação. A política de cada campo
   vem do mapa de includes/validacao.php (chave "mod").

   Comparação resistente a disfarces: além do texto normal, as regras de
   palavras rodam sobre um "esqueleto" do texto (minúsculas, sem acento,
   0→o, 1→i, 3→e, 4→a, 5→s, 7→t, @→a, $→s, letras separadas por espaço
   ou ponto juntadas, letras repetidas reduzidas). Quando a regra só casa
   no esqueleto, entra também a regra "evasao.filtro" e o risco sobe.
   Negações próximas ("sem taxa", "não pedimos senha") desarmam as
   regras de cobrança e de dados pessoais.

   Decisões proporcionais (jc_moderar):
     aceitar    → sem sinais relevantes;
     sinalizar  → risco baixo/médio: grava normalmente e cria (ou
                  atualiza) um item na fila de moderação;
     revisar    → risco alto: VAGA fica "pendente" (fora do ar até a
                  revisão humana); em perfis, item de prioridade alta;
     bloquear   → só tentativa de exploração técnica (HTML/JavaScript
                  executável): o envio é recusado com explicação.
   Nenhuma regra suspende contas: a suspensão é sempre uma decisão
   humana na Central administrativa.

   A fila NÃO copia o texto: guarda o hash (SHA-256) do conteúdo
   avaliado; o moderador abre o recurso original por uma página
   autorizada da Central.
   ============================================================ */
