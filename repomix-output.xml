#!/usr/bin/env bash
# ======================================================================
#  iniciar_ia.sh - inicia o servidor de IA (IA/recomendar.py) no Linux
#  (mesmas regras do iniciar_ia.bat do Windows)
#
#  Uso: bash iniciar_ia.sh
#
#  Usa SOMENTE o ambiente oficial do projeto: <pasta deste arquivo>/venv
#   - nunca roda a IA com o Python do sistema;
#   - nunca adota outro ambiente (venv-NOMEDOPC, .venv...) e nunca apaga nada;
#   - se o venv estiver ausente ou invalido (ex.: copiado de outro PC ou criado
#     no Windows), PARA e explica. Com a sua confirmacao (S), reconstroi o venv
#     neste computador, guardando o anterior como venv.antigo-<data>.
#  A IA roda em segundo plano (saida em logs/ia_console.log). Para desligar:
#  bash parar_jovemconnect.sh (ou kill <pid gravado em logs/ia_porta.json>).
#  Porta: a IA tenta a 5000 (JC_IA_PORTA) e, se outro programa estiver nela,
#  a faixa JC_IA_PORTAS_EXTRAS (padrao 5001-5010). Nenhum processo e encerrado.
#  Diagnostico: na tela e em logs/iniciar_ia.log (sem senhas ou dados pessoais).
# ======================================================================

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PASTA="$(basename "$RAIZ")"
VENV="$RAIZ/venv"
PY="$VENV/bin/python"
APP="$RAIZ/IA/recomendar.py"
CHK="$RAIZ/IA/verificar_ambiente.py"
REQ="$RAIZ/IA/requirements-ia.txt"
LOG="$RAIZ/logs/iniciar_ia.log"
CONSOLE="$RAIZ/logs/ia_console.log"

# Isola o Python de configuracoes do computador
unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
export PYTHONNOUSERSITE=1
export JC_LOG_INICIAR="$LOG"

log() { printf '%s\n' "$*"; printf '%s\n' "$*" >> "$LOG" 2>/dev/null; return 0; }
perguntar() {
    local resposta=""
    printf '%s [S/N] ' "$1"
    read -r resposta || { echo; return 1; }
    case "$resposta" in [sS]*) return 0 ;; *) return 1 ;; esac
}
falhou() {
    echo
    echo "  Diagnostico salvo em logs/iniciar_ia.log"
    exit 1
}

motivo() {
    case "$1" in
        ausente) if [ -e "$VENV/Scripts/python.exe" ]; then
                     log "  Motivo: este venv foi criado no WINDOWS (tem venv/Scripts, nao venv/bin)."
                     log "  Atencao: se esta mesma pasta tambem for usada no Windows, depois de reconstruir"
                     log "  aqui o iniciar_ia.bat vai pedir para reconstruir o venv de novo la."
                 else
                     log "  Motivo: nao existe venv/bin/python."
                 fi ;;
        10) log "  Motivo: o Python do venv nao pertence a esta pasta do projeto." ;;
        11) log "  Motivo: o venv usa uma versao de Python antiga demais (minimo 3.10)." ;;
        12) log "  Motivo: faltam pacotes da IA no venv (flask / flask-cors)." ;;
        *)  log "  Motivo: o Python do venv nem abre (codigo $1). Normalmente o venv foi criado em OUTRO computador." ;;
    esac
    if [ -f "$VENV/pyvenv.cfg" ]; then
        local home
        home="$(grep -i '^home *=' "$VENV/pyvenv.cfg" | head -1 | cut -d= -f2-)"
        [ -n "$home" ] && log "  Este venv aponta para o Python em:$home"
    fi
}

reconstruir() {
    log "[R1] Procurando o Python instalado neste computador (3.10 ou mais novo)"
    local base="" c p
    for c in python3 python python3.13 python3.12 python3.11 python3.10; do
        p="$(command -v "$c" 2>/dev/null)" || continue
        if "$p" "$CHK" base; then base="$p"; break; fi
    done
    if [ -z "$base" ]; then
        log "ERRO: nenhum Python 3.10+ com venv foi encontrado neste computador."
        echo "  Instale, por exemplo (Debian/Ubuntu): sudo apt install python3 python3-venv"
        echo "  (Fedora: sudo dnf install python3)  e rode este arquivo de novo."
        return 1
    fi
    log "  Usando: $base"
    local ts
    ts="$("$base" "$CHK" carimbo)" || ts=""
    if [ -z "$ts" ]; then log "ERRO: nao consegui gerar a data para o nome do backup. Nada foi alterado."; return 1; fi
    if [ -e "$VENV" ]; then
        ANTIGO="venv.antigo-$ts"
        if [ -e "$RAIZ/$ANTIGO" ]; then
            log "ERRO: ja existe $ANTIGO; nada foi alterado. Rode de novo daqui a um segundo."
            return 1
        fi
        log "[R2] Guardando o venv atual como $ANTIGO (nada e apagado)"
        if ! mv "$VENV" "$RAIZ/$ANTIGO"; then
            log "ERRO: nao consegui renomear o venv atual (sem permissao?). Nada foi apagado."
            return 1
        fi
    fi
    log "[R3] Criando o venv oficial em $VENV"
    if ! "$base" -m venv "$VENV" || [ ! -x "$PY" ]; then
        log "ERRO: a criacao do venv falhou."
        [ -n "$ANTIGO" ] && log "  O ambiente anterior continua guardado em $ANTIGO."
        return 1
    fi
    log "[R4] Instalando as versoes fixas de IA/requirements-ia.txt (precisa de internet)"
    if ! "$PY" -m pip install --disable-pip-version-check --no-input -r "$REQ"; then
        log "ERRO: a instalacao das dependencias falhou (sem internet, proxy da rede ou bloqueio?)."
        [ -n "$ANTIGO" ] && log "  O ambiente anterior continua guardado em $ANTIGO."
        log "  O venv novo ficou incompleto; na proxima execucao este script oferece reconstruir de novo."
        return 1
    fi
    log "  Reconstrucao concluida. Conferindo de novo..."
    return 0
}

main() {
    cd "$RAIZ" || { echo "ERRO: nao consegui entrar na pasta do projeto."; exit 1; }
    mkdir -p "$RAIZ/logs" 2>/dev/null
    echo "--------------------------------------------------"
    echo "  A iniciar o servidor de IA do JovemConnect..."
    echo "--------------------------------------------------"
    log "=== Inicializacao em $(date '+%d/%m/%Y %H:%M:%S') ==="
    log "[1/5] Diagnostico"
    log "  Computador    : $(hostname 2>/dev/null)"
    log "  Raiz          : $RAIZ"
    log "  venv oficial  : $VENV"
    log "  Python oficial: $PY"
    local d
    for d in "$RAIZ"/venv-* "$RAIZ"/.venv; do
        [ -d "$d" ] && log "  Aviso: ambiente nao oficial encontrado e IGNORADO: $(basename "$d")"
    done
    for d in "$RAIZ"/venv.antigo-*; do
        [ -d "$d" ] && log "  Info: backup de ambiente anterior (nao usado): $(basename "$d")"
    done

    log "[2/5] Arquivos do projeto"
    if [ ! -f "$APP" ] || [ ! -f "$CHK" ] || [ ! -f "$REQ" ]; then
        log "ERRO: falta um arquivo do projeto (IA/recomendar.py, IA/verificar_ambiente.py ou IA/requirements-ia.txt)."
        falhou
    fi
    log "  OK: IA/recomendar.py, IA/verificar_ambiente.py e IA/requirements-ia.txt"

    local refeito="" rc
    ANTIGO=""
    while :; do
        log "[3/5] Ambiente oficial (venv)"
        rc="ausente"
        if [ -x "$PY" ]; then
            "$PY" "$CHK" verificar "$VENV" "$REQ"
            rc=$?
        fi
        [ "$rc" = "0" ] && break
        echo
        log "PROBLEMA: o ambiente oficial (venv) nao pode ser usado neste computador."
        motivo "$rc"
        if [ -n "$refeito" ]; then
            log "  O venv foi reconstruido, mas continua invalido. Nada mais foi alterado."
            falhou
        fi
        echo
        echo "  Um venv so funciona no computador (e no sistema) em que foi criado. A solucao"
        echo "  e criar o venv DESTE computador a partir do Python instalado aqui e das versoes"
        echo "  fixas em IA/requirements-ia.txt (precisa de internet so desta vez)."
        echo "  O venv atual NAO sera apagado: sera guardado como venv.antigo-<data>."
        echo
        if ! perguntar "Reconstruir o venv deste computador agora?"; then
            log "Reconstrucao recusada. Nada foi alterado."
            echo "  Para reconstruir depois, rode este arquivo de novo e responda S."
            falhou
        fi
        reconstruir || falhou
        refeito=1
    done

    log "[4/5] A IA ja esta rodando?"
    "$PY" "$CHK" ping
    rc=$?
    if [ "$rc" = "0" ]; then
        log "  Nao abro outra: a IA que ja esta no ar sera usada."
    else
        [ "$rc" = "1" ] && log "  Nao: a porta preferida esta livre."
        log "[5/5] Iniciando a IA em segundo plano (saida em logs/ia_console.log)"
        # Pasta de trabalho FORA do projeto (a IA usa caminhos absolutos), como no Windows
        # (o subshell vira a propria IA com "exec": nada fica preso a este terminal)
        if command -v setsid >/dev/null 2>&1; then
            ( cd "$RAIZ/.." || exit 1; exec setsid nohup "$PY" "$APP" >> "$CONSOLE" 2>&1 < /dev/null ) > /dev/null 2>&1 < /dev/null &
        else
            ( cd "$RAIZ/.." || exit 1; exec nohup "$PY" "$APP" >> "$CONSOLE" 2>&1 < /dev/null ) > /dev/null 2>&1 < /dev/null &
        fi
        if ! "$PY" "$CHK" esperar 20; then
            log "ERRO: a IA nao confirmou a porta em 20 segundos."
            log "  Veja o final de logs/ia_console.log (ex.: nenhuma porta livre na faixa)."
            log "  Nenhum processo foi encerrado."
            falhou
        fi
    fi

    local url="http://localhost/$PASTA/index.php"
    log "Plataforma: $url"
    if [ -z "${JC_NAO_ABRIR:-}" ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
    fi
    echo "  Para desligar a IA: bash parar_jovemconnect.sh"
    exit 0
}

main "$@"; exit $?
</file>

<file path="iniciar_jovemconnect.sh">
#!/usr/bin/env bash
# ======================================================================
#  iniciar_jovemconnect.sh - liga tudo para usar o JovemConnect no Linux
#  (versao Linux do iniciar_jovemconnect.bat)
#
#  Uso: bash iniciar_jovemconnect.sh
#
#   1. confere o PHP (versao, extensoes, .env, pastas gravaveis); se algo
#      nao bater, mostra o motivo e pergunta se continua mesmo assim
#   2. oferece liberar a escrita do Apache em logs/ e uploads/curriculos/
#   3. liga o Apache e o MySQL (XAMPP em /opt/lampp, ou os servicos do sistema),
#      se ainda nao estiverem ligados (pode pedir a senha do sudo)
#   4. banco de dados: se nao existir, pergunta se pode criar e importar o
#      schema.sql (so em banco vazio; nunca importa por cima, nunca apaga)
#   5. confere se o Apache bloqueia logs/ e uploads/curriculos/ (.htaccess)
#   6. inicia a IA (iniciar_ia.sh) e mostra o endereco do site
#  Nada e apagado. Nenhum programa de terceiros e encerrado.
#  Para desligar (e, se quiser, limpar este computador): parar_jovemconnect.sh
#  Diagnostico: na tela e em logs/iniciar_jovemconnect.log
# ======================================================================

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PASTA="$(basename "$RAIZ")"
LOG="$RAIZ/logs/iniciar_jovemconnect.log"
# shellcheck source=scripts/linux_comum.sh
. "$RAIZ/scripts/linux_comum.sh" || { echo "ERRO: falta scripts/linux_comum.sh"; exit 1; }

falhou() {
    echo
    echo "  Diagnostico salvo em logs/iniciar_jovemconnect.log"
    exit 1
}

main() {
    cd "$RAIZ" || { echo "ERRO: nao consegui entrar na pasta do projeto."; exit 1; }
    mkdir -p "$RAIZ/logs" 2>/dev/null
    echo "--------------------------------------------------"
    echo "  JovemConnect - preparando tudo..."
    echo "--------------------------------------------------"
    log "=== Inicializacao em $(date '+%d/%m/%Y %H:%M:%S') (computador $(hostname 2>/dev/null)) ==="

    # --- 1. PHP -------------------------------------------------------------
    log "[1/6] PHP"
    log "  Projeto: $RAIZ"
    log "  Ambiente: $MODO$([ "$MODO" = xampp ] && echo " ($LAMPP)")"
    if [ -z "$PHP" ] || [ ! -x "$PHP" ]; then
        log "ERRO: nao achei o PHP (nem $LAMPP/bin/php, nem 'php' no PATH)."
        echo "  Instale o XAMPP para Linux, ou o PHP do sistema (ex.: sudo apt install php php-mysql php-curl php-mbstring)."
        falhou
    fi
    log "  PHP    : $PHP"
    if [ ! -f "$AJUDA" ]; then
        log "ERRO: falta scripts/jovemconnect.php. Confira se a pasta do projeto foi copiada inteira."
        falhou
    fi
    ajuda checar
    local rc=$?
    if [ "$rc" != "0" ] && [ "$rc" != "20" ]; then
        echo
        log "AVISO: alguma verificacao nao bateu (veja as linhas acima)."
        if ! perguntar "Continuar mesmo assim? (o que depender disso pode nao funcionar)"; then
            log "Parado a seu pedido: a checagem do PHP nao bateu."
            falhou
        fi
        log "  Continuando por escolha do usuario, apesar do aviso."
    fi
    if [ ! -f "$RAIZ/.env" ]; then
        echo
        if perguntar "Nao existe .env. Criar a partir do .env.example (banco root sem senha, padrao do XAMPP)?"; then
            ajuda criar-env
        else
            log "  Sem .env: o site usa o padrao (localhost, root, sem senha, banco jovemconnect)."
        fi
    fi

    # --- 2. Permissoes ------------------------------------------------------
    log "[2/6] Permissoes de escrita do Apache (logs/ e uploads/curriculos/)"
    mkdir -p "$RAIZ/uploads/curriculos" 2>/dev/null
    local p falta=""
    for p in logs uploads/curriculos; do
        # O Apache roda com outro usuario (daemon, www-data, apache): precisa de escrita para "outros"
        if [ -d "$RAIZ/$p" ] && [ "$(stat -c %A "$RAIZ/$p" 2>/dev/null | cut -c9)" != "w" ]; then falta="$falta $p"; fi
    done
    if [ -z "$falta" ]; then
        log "  OK."
    else
        log "  O Apache pode nao conseguir gravar em:$falta"
        if perguntar "Liberar a escrita nessas pastas (chmod -R a+rwX; elas ja sao bloqueadas para o navegador)?"; then
            for p in $falta; do chmod -R a+rwX "$RAIZ/$p" && log "  Liberado: $p"; done
        else
            log "  Mantido como esta: logs e envio de curriculos podem falhar."
        fi
    fi

    # --- 3. Apache e MySQL --------------------------------------------------
    log "[3/6] Apache (porta 80)"
    if ajuda porta 80; then
        if ajuda apache || ajuda site "$PASTA"; then
            log "  Ja estava ligado."
        else
            log "ERRO: a porta 80 esta ocupada por um programa que nao e o Apache."
            ajuda quem-usa 80
            log "  Feche esse programa e rode de novo. Nada foi encerrado."
            falhou
        fi
    else
        log "  Ligando o Apache..."
        servico ligar apache
        if ! ajuda esperar-porta 80 25; then
            log "ERRO: o Apache nao ligou em 25 segundos."
            ajuda quem-usa 80
            falhou
        fi
        log "  OK: Apache ligado."
    fi

    log "[4/6] MySQL (porta 3306)"
    if ajuda porta 3306; then
        log "  Ja estava ligado."
    else
        log "  Ligando o MySQL..."
        servico ligar mysql
        if ! ajuda esperar-porta 3306 40; then
            log "ERRO: o MySQL nao ligou em 40 segundos."
            ajuda quem-usa 3306
            falhou
        fi
        log "  OK: MySQL ligado."
    fi

    # --- 4. Banco -----------------------------------------------------------
    log "[5/6] Banco de dados"
    ajuda banco-status
    rc=$?
    if [ "$rc" = "10" ] || [ "$rc" = "11" ]; then
        echo
        if ! perguntar "Criar o banco agora e instalar a estrutura (schema.sql)?"; then
            log "Banco nao criado. O site precisa dele: rode este arquivo de novo e responda S."
            falhou
        fi
        if ! ajuda banco-instalar; then
            log "ERRO: a instalacao do banco falhou (veja as linhas acima). Nada foi apagado."
            falhou
        fi
        echo
        perguntar "Carregar tambem os dados de DEMONSTRACAO (empresas, vagas e jovens ficticios)?" && ajuda banco-seed
    elif [ "$rc" != "0" ]; then
        log "ERRO: nao consegui consultar o banco (MySQL desligado, ou usuario/senha do .env errados)."
        if [ "$MODO" != "xampp" ]; then
            echo "  No MariaDB/MySQL do sistema, o usuario root normalmente so entra pelo sudo (sem senha pela rede)."
            echo "  Crie um usuario para o projeto e coloque-o em DB_USER/DB_PASS no .env, por exemplo:"
            echo "    sudo mysql -e \"CREATE USER 'jovemconnect'@'localhost' IDENTIFIED BY 'troque-esta-senha';"
            echo "                  GRANT ALL ON jovemconnect.* TO 'jovemconnect'@'localhost';\""
        fi
        falhou
    fi

    # --- 5. Site e protecao -------------------------------------------------
    log "[6/6] Site e protecao das pastas"
    if ajuda site "$PASTA"; then
        log "  OK: http://localhost/$PASTA/ responde."
        if ! ajuda protecao "$PASTA"; then
            log "  AVISO: o Apache nao esta aplicando os .htaccess do projeto. Logs e curriculos ficam"
            log "  acessiveis pelo navegador. Ative 'AllowOverride All' para a pasta do site no Apache"
            log "  (ex.: /etc/apache2/apache2.conf, bloco <Directory /var/www/>) e reinicie o Apache."
        fi
    else
        log "  AVISO: http://localhost/$PASTA/ nao mostrou o JovemConnect."
        log "  O Apache precisa servir a pasta-mae deste projeto (XAMPP: $LAMPP/htdocs; Apache do sistema: /var/www/html)."
    fi

    log "Iniciando o servidor de IA (iniciar_ia.sh)"
    bash "$RAIZ/iniciar_ia.sh"
    exit $?
}

main "$@"; exit $?
</file>

<file path="parar_jovemconnect.sh">
#!/usr/bin/env bash
# ======================================================================
#  parar_jovemconnect.sh - desliga o JovemConnect no Linux e, SE VOCE QUISER,
#  limpa este computador (versao Linux do parar_jovemconnect.bat)
#
#  Uso: bash parar_jovemconnect.sh
#
#   1. fecha a IA desta pasta (so ela: confere a instancia gravada)
#   2. pergunta se apaga o BANCO do projeto (DB_NAME do .env)
#   3. pergunta se desliga o Apache e o MySQL (XAMPP ou servicos do sistema)
#   4. pergunta se EXCLUI ESTA PASTA do projeto
#  Cada exclusao pede S e, depois, que voce DIGITE o nome (banco/pasta;
#  maiusculas tanto faz). Avisa se a pasta tem trabalho do Git sem commit
#  ou sem enviar.
#  NAO USE A LIMPEZA NO SEU PC PRINCIPAL: o que for excluido nao volta.
# ======================================================================

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PASTA="$(basename "$RAIZ")"
LOG=""
# shellcheck source=scripts/linux_comum.sh
. "$RAIZ/scripts/linux_comum.sh" || { echo "ERRO: falta scripts/linux_comum.sh"; exit 1; }

minusculas() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

aviso_git() {
    [ -d "$RAIZ/.git" ] || return 0
    if ! command -v git >/dev/null 2>&1; then
        echo "a pasta e um repositorio Git e o git nao esta instalado aqui para conferir se ha trabalho nao enviado."
        return 0
    fi
    local alterados pendentes msg=""
    alterados="$(git -C "$RAIZ" status --porcelain 2>/dev/null | wc -l)"
    pendentes="$(git -C "$RAIZ" log --oneline '@{u}..' 2>/dev/null | wc -l)"
    [ "$alterados" != "0" ] && msg="ha $alterados arquivo(s) alterado(s) sem commit."
    [ "$pendentes" != "0" ] && msg="$msg Ha $pendentes commit(s) que nao foram enviados ao GitHub."
    printf '%s' "$msg"
}

excluir_pasta() {
    echo
    echo "[4/4] Pasta do projeto"
    perguntar "EXCLUIR a pasta $RAIZ deste computador?" || return 0
    # Mesmas protecoes do Windows: so uma pasta do JovemConnect servida pelo Apache
    local pai
    pai="$(basename "$(dirname "$RAIZ")")"
    case "$RAIZ" in
        /var/www/*) ;;
        *) if [ "$(minusculas "$pai")" != "htdocs" ]; then
               echo "  Por seguranca, so excluo uma pasta do JovemConnect que esteja dentro de .../htdocs/ ou /var/www/."
               echo "  Nada foi excluido."
               return 0
           fi ;;
    esac
    if [ -z "$RAIZ" ] || [ "$RAIZ" = "/" ] || [ ! -f "$RAIZ/index.php" ] || [ ! -f "$RAIZ/includes/ia_endereco.php" ] \
       || [ ! -f "$RAIZ/scripts/jovemconnect.php" ]; then
        echo "  Esta pasta nao parece ser a do JovemConnect. Nada foi excluido."
        return 0
    fi
    local aviso
    aviso="$(aviso_git)"
    if [ -n "$aviso" ]; then
        echo
        echo "  ATENCAO: $aviso"
        echo "  Se excluir a pasta, esse trabalho se perde."
    fi
    local conf=""
    printf '%s' "  Para confirmar, digite o nome da pasta ($PASTA; maiusculas tanto faz): "
    read -r conf || conf=""
    if [ "$(minusculas "$conf")" != "$(minusculas "$PASTA")" ]; then
        echo "  Nome diferente: a pasta NAO foi excluida."
        return 0
    fi
    # Este script ja foi lido inteiro (tudo esta em funcoes), entao pode apagar a propria pasta
    cd / || return 0
    local tentativa
    for tentativa in 1 2 3; do
        echo "  Tentativa $tentativa de 3: excluindo $RAIZ ..."
        chmod -R u+rwX "$RAIZ" 2>/dev/null
        rm -rf -- "$RAIZ" 2>/dev/null
        [ -e "$RAIZ" ] || break
        sleep 2
    done
    if [ -e "$RAIZ" ]; then
        echo
        echo "  Nao consegui excluir tudo. Ainda restam (primeiros itens):"
        find "$RAIZ" 2>/dev/null | head -15 | sed 's/^/    /'
        echo "  Normalmente sao arquivos criados pelo Apache (outro usuario, ex.: daemon ou www-data)."
        if perguntar "  Tentar de novo com sudo?"; then
            $SUDO rm -rf -- "$RAIZ"
        fi
    fi
    if [ -e "$RAIZ" ]; then
        echo "  A pasta NAO foi excluida por completo: $RAIZ"
    else
        echo "  Pasta excluida: $RAIZ"
    fi
}

main() {
    cd "$RAIZ" || { echo "ERRO: nao consegui entrar na pasta do projeto."; exit 1; }
    echo "--------------------------------------------------"
    echo "  JovemConnect - desligar e limpar"
    echo "  Pasta: $RAIZ"
    echo "--------------------------------------------------"
    local tem_php=1 banco=""
    if [ -z "$PHP" ] || [ ! -x "$PHP" ] || [ ! -f "$AJUDA" ]; then
        tem_php=""
        echo
        echo "  Nao achei o PHP: pulo a IA, o banco e o Apache/MySQL."
        echo "  Se a IA estiver rodando, encerre-a antes (kill <pid de logs/ia_porta.json>)."
    else
        banco="$(ajuda banco-nome)"
    fi

    if [ -n "$tem_php" ]; then
        # --- 1. IA ---
        echo
        echo "[1/4] Fechando a IA desta pasta..."
        ajuda ia-parar

        # --- 2. Banco ---
        echo
        echo "[2/4] Banco de dados ($banco)"
        if perguntar "Apagar o banco $banco deste computador, com TODOS os dados dele?"; then
            local ok_mysql=1
            if ! ajuda porta 3306; then
                echo "  O MySQL esta desligado; ligando so para apagar o banco..."
                servico ligar mysql
                ajuda esperar-porta 3306 40 || ok_mysql=""
            fi
            if [ -z "$ok_mysql" ]; then
                echo "  ERRO: o MySQL nao ligou; o banco NAO foi apagado."
            else
                local conf=""
                printf '%s' "  Para confirmar, digite o nome do banco ($banco; maiusculas tanto faz): "
                read -r conf || conf=""
                if [ "$(minusculas "$conf")" = "$(minusculas "$banco")" ]; then
                    ajuda banco-apagar "$banco"
                else
                    echo "  Nome diferente: o banco NAO foi apagado."
                fi
            fi
        fi

        # --- 3. Apache e MySQL ---
        echo
        echo "[3/4] Apache e MySQL"
        [ "$MODO" = "sistema" ] && echo "  (sao os servicos do sistema: outros sites deste computador tambem param)"
        if perguntar "Desligar o Apache e o MySQL?"; then
            servico desligar apache
            servico desligar mysql
        fi
    fi

    excluir_pasta
    echo
    echo "  Pronto."
    exit 0
}

main "$@"; exit $?
</file>

