# Copie este arquivo para ".env" (já ignorado pelo Git) e preencha com
# credenciais reais. Nunca commite o .env com valores reais.
# Explicação de cada variável: docs/CONFIGURACAO.md

# --- Banco de dados (includes/config.php) ---------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=jovemconnect

# --- SMTP (usado por includes/mailer.php) ---------------------------------
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario@seuprovedor.com
SMTP_PASS=sua-senha-ou-app-password
SMTP_SECURE=tls
# SMTP_SECURE aceita: tls, ssl, ou none (none só para relay local/confiável sem TLS)
SMTP_FROM_EMAIL=naoresponda@jovemconnect.com
SMTP_FROM_NAME=JovemConnect

# --- Twilio (usado por includes/sms.php) ----------------------------------
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=sua-auth-token-do-twilio
TWILIO_FROM_NUMBER=+15551234567

# --- Gemini (opcional — análise do Match e Assistente, IA/recomendar.py) ---
# Sem chave, o Match tradicional funciona normalmente. Use uma chave NOVA
# (a antiga ficou no histórico do Git e deve ser revogada).
GEMINI_API_KEY=
# Modelo (opcional). Padrão: gemini-3.5-flash-lite
GEMINI_MODEL=
# Tempo máximo de espera em segundos (opcional). Padrão: 12
GEMINI_TIMEOUT=

# --- Logs (opcional — includes/logger.php e IA/recomendar.py) -------------
# Pasta dos logs (padrão: logs/ do projeto), tamanho máximo (MB) e dias guardados
JC_LOG_DIR=
JC_LOG_MAX_MB=2
JC_LOG_DIAS=30

# --- Porta do servidor de IA (opcional — IA/recomendar.py, includes/ia_endereco.php)
# A IA tenta JC_IA_PORTA (padrão 5000); se outro programa estiver nela, usa a
# primeira livre de JC_IA_PORTAS_EXTRAS (padrão 5001-5010; no máximo 50 portas)
# e grava a escolhida em logs/ia_porta.json, que o PHP lê. Portas de 1024 a 65535.
JC_IA_PORTA=
JC_IA_PORTAS_EXTRAS=

# --- Central administrativa (opcional — includes/admin/sessao.php) --------
# Encerra a sessão administrativa após N segundos sem uso (padrão 900 = 15 min;
# aceito de 120 a 3600) e N segundos depois da entrada (padrão 28800 = 8 h;
# aceito de 900 a 43200). Administradores são criados só pela linha de comando:
# php scripts/admin.php criar --email=... --nome="..." (docs/ADMINISTRACAO_E_MODERACAO.md)
JC_ADMIN_OCIOSO_SEG=
JC_ADMIN_MAX_SEG=

# --- Segurança (opcional — includes/env.php e includes/tentativas.php) ----
# Erros do PHP na tela: por padrão vão só para o log do PHP e NÃO aparecem na
# página (mostrariam caminhos e trechos de SQL a qualquer visitante). Para vê-los
# na tela enquanto desenvolve, use 1; deixe vazio para apresentar ou publicar.
JC_EXIBIR_ERROS=
# Pasta dos contadores do limite de tentativas (login e códigos de 6 dígitos).
# Padrão: pasta temporária do sistema. Para liberar alguém bloqueado antes do
# prazo: php scripts/jovemconnect.php limpar-tentativas
JC_TENTATIVAS_DIR=
# Ambiente: vazio = desenvolvimento/apresentação (padrão). "producao" = contas de
# demonstração (@demo.jovemconnect.example, senha pública) NÃO entram e o comando
# "banco-seed" se recusa a carregar os dados de demonstração.
JC_AMBIENTE=
