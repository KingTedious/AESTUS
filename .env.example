# Copie este arquivo para ".env" (já ignorado pelo Git) e preencha com
# credenciais reais. Nunca commite o .env com valores reais.

# --- SMTP (usado por includes/mailer.php) ---------------------------------
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario@seuprovedor.com
SMTP_PASS=sua-senha-ou-app-password
SMTP_SECURE=tls
# SMTP_SECURE aceita: tls, ssl, ou none (none só para relay local/confiável sem TLS)
SMTP_FROM_EMAIL=naoresponda@jovemconnect.com
SMTP_FROM_NAME=JovemConnect

# --- Twilio (usado por includes/sms.php) ----------------------------------
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=sua-auth-token-do-twilio
TWILIO_FROM_NUMBER=+15551234567

# --- Gemini (opcional — análise contextual do Match, IA/recomendar.py) -----
# Sem chave, o Match tradicional funciona normalmente. Use uma chave NOVA
# (a antiga ficou no histórico do Git e deve ser revogada).
GEMINI_API_KEY=
# Modelo (opcional). Padrão: gemini-3.5-flash-lite
GEMINI_MODEL=
# Tempo máximo de espera em segundos (opcional). Padrão: 12
GEMINI_TIMEOUT=
